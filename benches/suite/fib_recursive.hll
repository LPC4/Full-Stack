; Naive recursive Fibonacci: call/return overhead and deep, highly
; predictable branching. Depth scales with input size, capped.
console := import("console")

fib: (k: i64) -> i64 {
    if k < 2 {
        return k
    }
    return fib(k - 1) + fib(k - 2)
}

main: () -> i32 {
    k: i64 = 18 + {{N}}
    if k > 27 {
        k = 27
    }
    v: i64 = fib(k)
    console.print_int(v)
    if v == 0 { return 1 }
    return 0
}
