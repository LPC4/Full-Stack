; Load-use hazard chain: each loaded value is the next load address,
; so the pipeline stalls on every iteration.
console := import("console")

main: () -> i32 {
    next: i64[4096] = []
    i: i64 = 0
    while i < 4096 {
        next[i] = (i + 1) % 4096
        i = i + 1
    }
    n: i64 = {{N}}
    idx: i64 = 0
    steps: i64 = 0
    while steps < n {
        idx = next[idx]
        steps = steps + 1
    }
    console.print_int(idx)
    if idx != n % 4096 { return 1 }
    return 0
}
