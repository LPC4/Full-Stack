; Stride-1 walk over a 64 KiB array: near-perfect L1 hit rate, so
; realistic memory latency barely changes total cycles.
console := import("console")

main: () -> i32 {
    buf: i64[8192] = []
    i: i64 = 0
    while i < 8192 {
        buf[i] = i & 511
        i = i + 1
    }
    passes: i64 = {{N}}
    sum: i64 = 0
    p: i64 = 0
    while p < passes {
        j: i64 = 0
        while j < 8192 {
            sum = sum + buf[j]
            j = j + 1
        }
        p = p + 1
    }
    console.print_int(sum)
    if sum == 0 { return 1 }
    return 0
}
