; Sieve of Eratosthenes over a fixed 8192 capacity, repeated {{N}} times.
; Checksum is the prime count, stable across repeats.
console := import("console")

main: () -> i32 {
    flags: i64[8192] = []
    passes: i64 = {{N}}
    count: i64 = 0
    p: i64 = 0
    while p < passes {
        i: i64 = 0
        while i < 8192 {
            flags[i] = 1
            i = i + 1
        }
        flags[0] = 0
        flags[1] = 0
        d: i64 = 2
        while d * d < 8192 {
            if flags[d] == 1 {
                m: i64 = d * d
                while m < 8192 {
                    flags[m] = 0
                    m = m + d
                }
            }
            d = d + 1
        }
        count = 0
        i2: i64 = 0
        while i2 < 8192 {
            count = count + flags[i2]
            i2 = i2 + 1
        }
        p = p + 1
    }
    console.print_int(count)
    if count == 0 { return 1 }
    return 0
}
