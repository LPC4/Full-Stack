; Read-modify-write array traversal with regalloc OFF in both variants.
; slot reloads and address arithmetic are what the peephole pass folds.
console := import("console")

main: () -> i32 {
    buf: i64[64] = []
    i: i64 = 0
    while i < 64 {
        buf[i] = i & 255
        i = i + 1
    }
    passes: i64 = {{N}}
    p: i64 = 0
    while p < passes {
        j: i64 = 0
        while j < 64 {
            buf[j] = buf[j] + (j & 7)
            j = j + 1
        }
        p = p + 1
    }
    sum: i64 = 0
    j2: i64 = 0
    while j2 < 64 {
        sum = sum + buf[j2]
        j2 = j2 + 1
    }
    console.print_int(sum)
    if sum == 0 { return 1 }
    return 0
}
