fibonacci: (n: i32) -> i32 {
	if n <= 1 { return n }

	previous: i32 = 0
	current: i32 = 1
	index: i32 = 2
	while index <= n {
		next: i32 = previous + current
		previous = current
		current = next
		index = index + 1
	}
	return current
}

main: () -> i32 {
	if fibonacci(0) != 0 { return 1 }
	if fibonacci(1) != 1 { return 2 }
	return fibonacci(12)
}
