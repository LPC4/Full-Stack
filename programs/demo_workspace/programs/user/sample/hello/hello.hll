; HLL-0 program for the in-VM `cc` (prints "HLL0\nY", exits 36). putc resolves at
; link time: cc hello.hll hello.s, as it plus stdlib.s, then ld stdlib.o hello.o hello.

sum_to: (n: i32) -> i32 {
    total: i32 = 0
    i: i32 = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

main: () -> i32 {
    putc('H')
    putc('L')
    putc('L')
    putc('0')
    putc('\n')
    n: i32 = sum_to(8)
    if n > 30 {
        putc('Y')
    }
    return n
}
