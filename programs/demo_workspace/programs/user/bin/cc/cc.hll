; In-VM HLL-0 compiler: `cc <src.hll> <out.s>`.
console := import("console")
sys := import("sys")
cstr := import("cstr")
text := import("text")
runtime := import("runtime")
codegen := import("./cc_codegen.hll")

; --- Compiler state ---
src: u8* = null
src_len: u64 = 0

toks: Token* = null
ntok: i64 = 0

export nodes: Node* = null
nnode: i64 = 0
export call_args: i64* = null
ncallarg: i64 = 0
export fns: Fn* = null
export nfn: i64 = 0

loc_name: u8* = null
loc_count: i64 = 0

pos: i64 = 0
asmout: u8* = null
asmlen: u64 = 0

err_flag: i64 = 0
export cur_fn: i64 = 0
export nlabel: i64 = 0

export name_eq: (name: u8*, expected: u8[]) -> i64 {
    return cstr.eq_slice(cstr.view(name, 16), expected)
}

export perr: (msg: u8*) {
    if err_flag == 0 {
        console.write("cc: ".ptr)
        console.writeln(msg)
    }
    err_flag = 1
}

; --- Output emission ---
emit_ch: (c: u8) {
    if asmlen < 32768 {
        asmout[asmlen] = c
        asmlen = asmlen + 1
    }
}

export emit_str: (s: u8*) {
    i: u64 = 0
    while @(s + i) != 0 {
        emit_ch(@(s + i))
        i = i + 1
    }
}

export emit_int: (v: i64) {
    if v < 0 {
        emit_ch('-' as u8)
        v = 0 - v
    }
    if v == 0 {
        emit_ch('0' as u8)
        return
    }
    buf: u8[24] = []
    n: i64 = 0
    while v > 0 {
        buf[n] = ('0' + v % 10) as u8
        n = n + 1
        v = v / 10
    }
    while n > 0 {
        n = n - 1
        emit_ch(buf[n])
    }
}

; --- Tokenizer ---
push_tok: (kind: TokenKind, val: i64) {
    if ntok < 2048 {
        t: Token* = &toks[ntok]
        t.len = 0
        t.kind = kind
        t.val = val
        d: u8* = (&toks[ntok]) as u8*
        @d = 0 as u8
        ntok = ntok + 1
    }
}

token_tag: (kind: TokenKind) -> i64 {
    return match kind {
        TokEof    -> 0
        TokInt    -> 1
        TokIdent  -> 2
        TokLParen -> 3
        TokRParen -> 4
        TokLBrace -> 5
        TokRBrace -> 6
        TokComma  -> 7
        TokColon  -> 8
        TokArrow  -> 9
        TokAssign -> 10
        TokPlus   -> 11
        TokMinus  -> 12
        TokStar   -> 13
        TokSlash  -> 14
        TokPct    -> 15
        TokLt     -> 16
        TokLe     -> 17
        TokGt     -> 18
        TokGe     -> 19
        TokEq     -> 20
        TokNe     -> 21
    }
}

kind_is: (actual: TokenKind, expected: TokenKind) -> bool {
    return token_tag(actual) == token_tag(expected)
}

set_tok_txt: (idx: i64, start: u64, len: u64) {
    d: u8* = (&toks[idx]) as u8*
    for k in 0..len {
        if k < 15 {
            e: u8* = d + k
            @e = src[start + k]
        }
    }
    t: u64 = len
    if t > 15 {
        t = 15
    }
    toks[idx].len = t
}

scan_punct: (i: u64) -> u64 {
    c: u8 = src[i]
    d: u8 = 0 as u8
    if i + 1 < src_len {
        d = src[i + 1]
    }
    if c == '-' {
        if d == '>' {
            push_tok(TokenKind.TokArrow, 0)
            return i + 2
        }
    }
    if c == '<' {
        if d == '=' {
            push_tok(TokenKind.TokLe, 0)
            return i + 2
        }
    }
    if c == '>' {
        if d == '=' {
            push_tok(TokenKind.TokGe, 0)
            return i + 2
        }
    }
    if c == '=' {
        if d == '=' {
            push_tok(TokenKind.TokEq, 0)
            return i + 2
        }
    }
    if c == '!' {
        if d == '=' {
            push_tok(TokenKind.TokNe, 0)
            return i + 2
        }
    }
    match c {
        '(' -> { push_tok(TokenKind.TokLParen, 0) }
        ')' -> { push_tok(TokenKind.TokRParen, 0) }
        '{' -> { push_tok(TokenKind.TokLBrace, 0) }
        '}' -> { push_tok(TokenKind.TokRBrace, 0) }
        ',' -> { push_tok(TokenKind.TokComma, 0) }
        ':' -> { push_tok(TokenKind.TokColon, 0) }
        '=' -> { push_tok(TokenKind.TokAssign, 0) }
        '+' -> { push_tok(TokenKind.TokPlus, 0) }
        '-' -> { push_tok(TokenKind.TokMinus, 0) }
        '*' -> { push_tok(TokenKind.TokStar, 0) }
        '/' -> { push_tok(TokenKind.TokSlash, 0) }
        '%' -> { push_tok(TokenKind.TokPct, 0) }
        '<' -> { push_tok(TokenKind.TokLt, 0) }
        '>' -> { push_tok(TokenKind.TokGt, 0) }
        _   -> { perr("bad character".ptr) }
    }
    return i + 1
}

char_escape: (e: u8) -> i64 {
    return match e {
        'n' -> 10
        't' -> 9
        'r' -> 13
        'b' -> 8
        '0' -> 0
        _   -> e as i64
    }
}

tokenize: () {
    ntok = 0
    i: u64 = 0
    while i < src_len {
        c: u8 = src[i]
        if text.is_space(c) {
            i = i + 1
        } else {
            if c == ';' {
                while i < src_len {
                    if src[i] == '\n' {
                        break
                    }
                    i = i + 1
                }
            } else {
                if text.is_alpha(c) {
                    start: u64 = i
                    while i < src_len {
                        if text.is_alnum(src[i]) {
                            i = i + 1
                        } else {
                            break
                        }
                    }
                    idx: i64 = ntok
                    push_tok(TokenKind.TokIdent, 0)
                    set_tok_txt(idx, start, i - start)
                } else {
                    if text.is_digit(c) {
                        v: i64 = 0
                        while i < src_len {
                            d: u8 = src[i]
                            if text.is_digit(d) {
                                v = v * 10 + (d as i64 - '0')
                                i = i + 1
                            } else {
                                break
                            }
                        }
                        push_tok(TokenKind.TokInt, v)
                    } else {
                        if c == '\'' {
                            i = i + 1
                            cv: i64 = 0
                            e: u8 = src[i]
                            if e == '\\' {
                                i = i + 1
                                cv = char_escape(src[i])
                                i = i + 1
                            } else {
                                cv = e as i64
                                i = i + 1
                            }
                            if src[i] == '\'' {
                                i = i + 1
                            } else {
                                perr("unterminated char literal".ptr)
                            }
                            push_tok(TokenKind.TokInt, cv)
                        } else {
                            i = scan_punct(i)
                        }
                    }
                }
            }
        }
    }
    push_tok(TokenKind.TokEof, 0)
}

; --- Token cursor ---
cur_kind: () -> TokenKind {
    if pos < ntok {
        t: Token* = &toks[pos]
        return t.kind
    }
    return TokenKind.TokEof
}

cur_val: () -> i64 {
    t: Token* = &toks[pos]
    return t.val
}

cur_txt: () -> u8[] {
    token: Token* = &toks[pos]
    empty: u8[1] = []
    view: u8[] = empty[0..0]
    view.ptr = token as u8*
    view.len = token.len
    return view
}

nxt_kind: () -> TokenKind {
    if pos + 1 < ntok {
        t: Token* = &toks[pos + 1]
        return t.kind
    }
    return TokenKind.TokEof
}

adv: () {
    pos = pos + 1
}

expect: (k: TokenKind, msg: u8*) {
    if kind_is(cur_kind(), k) {
        adv()
    } else {
        perr(msg)
    }
}

; --- AST ---
mk: (kind: NodeKind) -> i64 {
    id: i64 = nnode
    nd: Node* = &nodes[id]
    nd.kind = kind
    nd.op = TokenKind.TokEof
    nd.a = 0
    nd.b = 0
    nd.c = 0
    nd.next = -1
    nnode = nnode + 1
    return id
}

set_name: (node: i64, s: u8*) {
    text.copy_name16((&nodes[node]) as u8*, cstr.view(s, 16))
}

; --- Locals ---
add_local: (name: u8*) -> i64 {
    slot: i64 = loc_count
    text.copy_name16(loc_name + (slot as u64) * 16, cstr.view(name, 16))
    loc_count = loc_count + 1
    return slot
}

find_local: (name: u8*) -> i64 {
    for i in 0..loc_count {
        c: u8* = loc_name + (i as u64) * 16
        if cstr.eq_slice(cstr.view(c, 16), cstr.view(name, 16)) == 1 {
            return i
        }
    }
    return -1
}

; --- Expressions ---
is_mulop: (k: TokenKind) -> i64 {
    return match k {
        TokStar  -> 1
        TokSlash -> 1
        TokPct   -> 1
        _        -> 0
    }
}

is_addop: (k: TokenKind) -> i64 {
    return match k {
        TokPlus  -> 1
        TokMinus -> 1
        _        -> 0
    }
}

is_relop: (k: TokenKind) -> i64 {
    return match k {
        TokLt -> 1
        TokLe -> 1
        TokGt -> 1
        TokGe -> 1
        _     -> 0
    }
}

is_eqop: (k: TokenKind) -> i64 {
    return match k {
        TokEq -> 1
        TokNe -> 1
        _     -> 0
    }
}

parse_primary: () -> i64 {
    k: TokenKind = cur_kind()
    match k {
    TokInt -> {
        v: i64 = cur_val()
        adv()
        n: i64 = mk(NodeKind.NodeInt)
        nd: Node* = &nodes[n]
        nd.a = v
        return n
    }
    TokLParen -> {
        adv()
        e: i64 = parse_expr()
        expect(TokenKind.TokRParen, "expected )".ptr)
        return e
    }
    TokIdent -> {
        nm: u8[24] = []
        text.copy_name16(&nm[0], cur_txt())
        adv()
        if kind_is(cur_kind(), TokenKind.TokLParen) {
            adv()
            n: i64 = mk(NodeKind.NodeCall)
            set_name(n, &nm[0])
            astart: i64 = ncallarg
            cnt: i64 = 0
            if kind_is(cur_kind(), TokenKind.TokRParen) == false {
                while 1 == 1 {
                    a: i64 = parse_expr()
                    call_args[ncallarg] = a
                    ncallarg = ncallarg + 1
                    cnt = cnt + 1
                    if kind_is(cur_kind(), TokenKind.TokComma) {
                        adv()
                    } else {
                        break
                    }
                }
            }
            expect(TokenKind.TokRParen, "expected ) in call".ptr)
            nd: Node* = &nodes[n]
            nd.b = astart
            nd.c = cnt
            return n
        }
        slot: i64 = find_local(&nm[0])
        if slot < 0 {
            perr("unknown variable".ptr)
            slot = 0
        }
        n: i64 = mk(NodeKind.NodeVar)
        nd: Node* = &nodes[n]
        nd.a = slot
        return n
    }
    _ -> {}
    }
    perr("expected expression".ptr)
    return mk(NodeKind.NodeInt)
}

parse_mul: () -> i64 {
    n: i64 = parse_primary()
    while is_mulop(cur_kind()) == 1 {
        op: TokenKind = cur_kind()
        adv()
        r: i64 = parse_primary()
        b: i64 = mk(NodeKind.NodeBinop)
        nd: Node* = &nodes[b]
        nd.op = op
        nd.b = n
        nd.c = r
        n = b
    }
    return n
}

parse_add: () -> i64 {
    n: i64 = parse_mul()
    while is_addop(cur_kind()) == 1 {
        op: TokenKind = cur_kind()
        adv()
        r: i64 = parse_mul()
        b: i64 = mk(NodeKind.NodeBinop)
        nd: Node* = &nodes[b]
        nd.op = op
        nd.b = n
        nd.c = r
        n = b
    }
    return n
}

parse_rel: () -> i64 {
    n: i64 = parse_add()
    while is_relop(cur_kind()) == 1 {
        op: TokenKind = cur_kind()
        adv()
        r: i64 = parse_add()
        b: i64 = mk(NodeKind.NodeBinop)
        nd: Node* = &nodes[b]
        nd.op = op
        nd.b = n
        nd.c = r
        n = b
    }
    return n
}

parse_expr: () -> i64 {
    n: i64 = parse_rel()
    while is_eqop(cur_kind()) == 1 {
        op: TokenKind = cur_kind()
        adv()
        r: i64 = parse_rel()
        b: i64 = mk(NodeKind.NodeBinop)
        nd: Node* = &nodes[b]
        nd.op = op
        nd.b = n
        nd.c = r
        n = b
    }
    return n
}

; --- Statements and functions ---
parse_stmt: () -> i64 {
    k: TokenKind = cur_kind()
    if kind_is(k, TokenKind.TokIdent) {
        t: u8[] = cur_txt()
        if cstr.eq_slice(t, "return") == 1 {
            adv()
            e: i64 = parse_expr()
            n: i64 = mk(NodeKind.NodeReturn)
            nd: Node* = &nodes[n]
            nd.a = e
            return n
        }
        if cstr.eq_slice(t, "if") == 1 {
            adv()
            c: i64 = parse_expr()
            expect(TokenKind.TokLBrace, "expected { after if".ptr)
            body: i64 = parse_block()
            expect(TokenKind.TokRBrace, "expected } after if".ptr)
            n: i64 = mk(NodeKind.NodeIf)
            nd: Node* = &nodes[n]
            nd.a = c
            nd.b = body
            return n
        }
        if cstr.eq_slice(t, "while") == 1 {
            adv()
            c: i64 = parse_expr()
            expect(TokenKind.TokLBrace, "expected { after while".ptr)
            body: i64 = parse_block()
            expect(TokenKind.TokRBrace, "expected } after while".ptr)
            n: i64 = mk(NodeKind.NodeWhile)
            nd: Node* = &nodes[n]
            nd.a = c
            nd.b = body
            return n
        }
        k1: TokenKind = nxt_kind()
        if kind_is(k1, TokenKind.TokColon) {
            nm: u8[24] = []
            text.copy_name16(&nm[0], cur_txt())
            adv()
            adv()
            expect(TokenKind.TokIdent, "expected type in decl".ptr)
            expect(TokenKind.TokAssign, "expected = in decl".ptr)
            e: i64 = parse_expr()
            slot: i64 = add_local(&nm[0])
            n: i64 = mk(NodeKind.NodeDecl)
            nd: Node* = &nodes[n]
            nd.a = slot
            nd.b = e
            return n
        }
        if kind_is(k1, TokenKind.TokAssign) {
            nm: u8[24] = []
            text.copy_name16(&nm[0], cur_txt())
            adv()
            adv()
            e: i64 = parse_expr()
            slot: i64 = find_local(&nm[0])
            if slot < 0 {
                perr("assignment to unknown variable".ptr)
                slot = 0
            }
            n: i64 = mk(NodeKind.NodeAssign)
            nd: Node* = &nodes[n]
            nd.a = slot
            nd.b = e
            return n
        }
    }
    e: i64 = parse_expr()
    n: i64 = mk(NodeKind.NodeExpr)
    nd: Node* = &nodes[n]
    nd.a = e
    return n
}

parse_block: () -> i64 {
    head: i64 = -1
    tail: i64 = -1
    while 1 == 1 {
        k: TokenKind = cur_kind()
        if kind_is(k, TokenKind.TokRBrace) {
            break
        }
        if kind_is(k, TokenKind.TokEof) {
            break
        }
        s: i64 = parse_stmt()
        if head < 0 {
            head = s
        } else {
            nd: Node* = &nodes[tail]
            nd.next = s
        }
        tail = s
        if err_flag != 0 {
            break
        }
    }
    return head
}

parse_function: () {
    if kind_is(cur_kind(), TokenKind.TokIdent) == false {
        perr("expected function name".ptr)
        return
    }
    fidx: i64 = nfn
    text.copy_name16((&fns[fidx]) as u8*, cur_txt())
    adv()
    expect(TokenKind.TokColon, "expected : after function name".ptr)
    expect(TokenKind.TokLParen, "expected ( before params".ptr)
    loc_count = 0
    np: i64 = 0
    if kind_is(cur_kind(), TokenKind.TokRParen) == false {
        while 1 == 1 {
            if kind_is(cur_kind(), TokenKind.TokIdent) == false {
                perr("expected parameter name".ptr)
                break
            }
            pn: u8[24] = []
            text.copy_name16(&pn[0], cur_txt())
            adv()
            expect(TokenKind.TokColon, "expected : in parameter".ptr)
            expect(TokenKind.TokIdent, "expected parameter type".ptr)
            add_local(&pn[0])
            np = np + 1
            if kind_is(cur_kind(), TokenKind.TokComma) {
                adv()
            } else {
                break
            }
        }
    }
    expect(TokenKind.TokRParen, "expected ) after params".ptr)
    expect(TokenKind.TokArrow, "expected ->".ptr)
    expect(TokenKind.TokIdent, "expected return type".ptr)
    expect(TokenKind.TokLBrace, "expected { before body".ptr)
    head: i64 = parse_block()
    expect(TokenKind.TokRBrace, "expected } after body".ptr)
    f: Fn* = &fns[fidx]
    f.nparams = np
    f.nlocals = loc_count
    f.body = head
    nfn = nfn + 1
}

parse_program: () {
    pos = 0
    nfn = 0
    while kind_is(cur_kind(), TokenKind.TokEof) == false {
        parse_function()
        if err_flag != 0 {
            return
        }
    }
}

main: () -> i32 {
    src = new(u8, 8192)
    toks = new(Token, 2048)
    nodes = new(Node, 1024)
    call_args = new(i64, 512)
    fns = new(Fn, 64)
    loc_name = new(u8, 1024)
    asmout = new(u8, 32768)
    if src == null or toks == null or nodes == null or call_args == null or
        fns == null or loc_name == null or asmout == null {
        console.writeln("cc: out of memory".ptr)
        return 1
    }

    arg: u8[] = runtime.arg()
    src_path: u8[128] = []
    out_path: u8[128] = []
    src_pp: u8* = &src_path[0]
    out_pp: u8* = &out_path[0]
    if text.split_two(arg, src_path[..], out_path[..]) == false {
        console.writeln("cc: usage: cc <src.hll> <out.s>".ptr)
        return 1
    }

    fd: i64 = sys.open(cstr.view(src_pp, 128), 0)
    if fd < 0 {
        console.write("cc: cannot open ".ptr)
        console.writeln(src_pp)
        return 1
    }
    n: i64 = sys.read(fd, src, 0, 8191)
    sys.close(fd)
    if n <= 0 {
        console.writeln("cc: empty source".ptr)
        return 1
    }
    src_len = n as u64
    src[src_len] = 0 as u8

    err_flag = 0
    nnode = 0
    ncallarg = 0
    nlabel = 0
    asmlen = 0
    tokenize()
    parse_program()
    if err_flag != 0 {
        return 1
    }
    codegen.gen_program()
    if err_flag != 0 {
        return 1
    }

    ofd: i64 = sys.open(cstr.view(out_pp, 128), 2)
    if ofd < 0 {
        console.write("cc: cannot create ".ptr)
        console.writeln(out_pp)
        return 1
    }
    sys.write(ofd, asmout, asmlen)
    sys.ftruncate(ofd, asmlen)
    sys.close(ofd)

    console.write("cc: wrote ".ptr)
    console.writeln(out_pp)
    return 0
}
