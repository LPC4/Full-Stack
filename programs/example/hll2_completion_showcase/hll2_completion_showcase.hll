; HLL2 completion showcase: function pointers, callable expressions, manual
; vtables, impl members, associated items, interfaces, bounds, and modules.

console := import("console")
memory_allocator := import("memory_allocator")
string := import("string")

mathlib := import("./modules/mathlib.hll")

type BinaryOp = (i32, i32) -> i32
type UnaryOp = (i32) -> i32

add: (a: i32, b: i32) -> i32 {
	return a + b
}

mul: (a: i32, b: i32) -> i32 {
	return a * b
}

square: (value: i32) -> i32 {
	return value * value
}

negate: (value: i32) -> i32 {
	return 0 - value
}

; A struct whose fields are function pointers: dependency injection and
; vtable-like records without classes. Each field is just data.
struct Calculator {
	combine: BinaryOp,
	transform: UnaryOp,
}

; --- Manual vtable idiom ---
; Dynamic dispatch without interfaces: a vtable of function pointers plus an
; object pairing a data pointer with its vtable pointer. No hidden `self`.
struct Shape {
	width: i32,
	height: i32,
}

type ShapeMethod = (Shape*) -> i32

struct ShapeVTable {
	area: ShapeMethod,
	perimeter: ShapeMethod,
}

struct ShapeObj {
	data: Shape*,
	vtable: ShapeVTable*,
}

rect_area: (s: Shape*) -> i32 {
	return s.width * s.height
}

rect_perimeter: (s: Shape*) -> i32 {
	return 2 * (s.width + s.height)
}

; Dynamic dispatch: load the vtable through the object pointer, then call the
; selected method with the object's own data. This is `o.vtable.area(o.data)`.
shape_area: (o: ShapeObj*) -> i32 {
	return o.vtable.area(o.data)
}

shape_perimeter: (o: ShapeObj*) -> i32 {
	return o.vtable.perimeter(o.data)
}

; Static method sugar: `impl Type { ... }` declares pointer-receiver methods.
; `r.area()` is sugar for the free function `Shape_area(&r)`, static dispatch.
impl Shape {
	; Associated compile-time members, projected as `Shape.SIDES`/`Shape.Pair`.
	const SIDES = 4
	type Pair = i32[2]
	make: (width: i32, height: i32) -> Shape {
		return Shape { .width = width, .height = height }
	}
	area: (self: Shape*) -> i32 {
		return self.width * self.height
	}
	scaled_area: (self: Shape*, k: i32) -> i32 {
		return self.area() * k
	}
	perimeter_value: (self: Shape) -> i32 {
		return 2 * (self.width + self.height)
	}
}

; --- Interfaces and generic bounds ---
; An interface lists required methods (`Self` = implementing type); a bound
; `<T: Measurable>` is checked when the generic specializes (spec 6.5).
interface Measurable {
	area: (self: Self*) -> i32
}

interface Scalable {
	scaled_area: (self: Self*, k: i32) -> i32
}

; Bounds apply to every generic declaration kind, without changing layout.
struct Measured<T: Measurable> {
	value: T*,
}

; A generic owner pattern: `Measured<Shape>.TAG` substitutes the owner argument.
impl Measured<T> {
	const TAG = 7
}

enum MaybeMeasured<T: Measurable> {
	Present(T),
	Missing,
}

; Two enums may declare the same variant name. A qualifier picks one; match arms
; resolve bare names against the scrutinee's enum.
enum Link {
	Idle,
	Busy(i32),
}

enum Spindle {
	Busy(i32),
	Spun,
}

type MeasuredPtr<T: Measurable> = T*

struct Disc {
	radius: i32,
}

impl Disc {
	area: (self: Disc*) -> i32 {
		return 3 * self.radius * self.radius
	}
	scaled_area: (self: Disc*, k: i32) -> i32 {
		return self.area() * k
	}
}

; Static dispatch: each instantiation resolves `v.area()` to that type's method.
double_area: <T: Measurable>(v: T*) -> i32 {
	return v.area() + v.area()
}

; Multiple bounds are joined with `+` and are all checked at specialization.
scaled_area: <T: Measurable + Scalable>(v: T*, k: i32) -> i32 {
	return v.scaled_area(k)
}

; A qualified bound uses an interface exported by another module. The concrete
; implementation also lives in that object and is checked before linking.
apply_imported: <T: mathlib.Applicable>(value: T*, n: i32) -> i32 {
	return value.apply(n)
}

; --- dyn: runtime polymorphism over an interface ---
; `dyn Measurable` is a wide pointer packing the object with its methods;
; `(&x) as dyn Measurable` converts explicitly, and calls dispatch at runtime.
sum_areas: (shapes: dyn Measurable*, count: i32) -> i32 {
	sum := 0
	for i in 0..count {
		sum += shapes[i].area()
	}
	return sum
}

; --- Literal match patterns ---
; A scalar `match` dispatches on integer/char equality; const names fold to
; literals, and a `_` or binding catch-all is required.
const OP_ADD = 1
const OP_MUL = 2

eval_op: (op: i32, a: i32, b: i32) -> i32 {
	return match op {
		OP_ADD -> a + b
		OP_MUL -> a * b
		_ -> -1
	}
}

classify_char: (c: i32) -> i32 {
	return match c {
		'+' -> OP_ADD
		'*' -> OP_MUL
		other -> other
	}
}

apply_binary: (op: BinaryOp, a: i32, b: i32) -> i32 {
	return op(a, b)
}

; Callable expressions: the callee is a struct field, not a bare name.
run_calculator: (calc: Calculator, a: i32, b: i32) -> i32 {
	combined := calc.combine(a, b)
	return calc.transform(combined)
}

apply_unary: (op: UnaryOp, value: i32) -> i32 {
	return op(value)
}

choose_binary: (multiply: bool) -> BinaryOp {
	if multiply {
		return mul
	}
	return add
}

; --- Explicit heap allocation and owned containers ---
; The allocator is fallible, alignment is explicit, and ownership ends at
; deallocate/deinit. Containers use the same ABI without hiding disposal.
showcase_heap: () -> i32 {
	bytes: u8* = null
	allocated := memory_allocator.allocate(8, 16)
	match allocated {
		Ok(ptr) -> { bytes = ptr }
		Err(error) -> { return 42 }
	}
	if (bytes as u64) % 16 != 0 { return 43 }
	bytes[0] = 21

	resized := memory_allocator.reallocate(bytes, 8, 32, 16)
	match resized {
		Ok(ptr) -> { bytes = ptr }
		Err(error) -> { return 44 }
	}
	if bytes[0] != 21 { return 45 }
	memory_allocator.deallocate(bytes, 32, 16)

	values: Vec<i32> = { .ptr = null, .len = 0, .capacity = 0 }
	Vec_init<i32>(&values)
	pushed := Vec_push<i32>(&values, 42)
	match pushed {
		Ok(len) -> {}
		Err(error) -> { return 46 }
	}
	slot: i32* = Vec_get<i32>(&values, 0)
	if slot == null or @slot != 42 { return 47 }
	Vec_deinit<i32>(&values)
	return 0
}

main: () -> i32 {
	; --- Function pointers, callable expressions, and non-capturing lambdas ---
	op: BinaryOp = add
	if op(20, 22) != 42 { return 1 }
	if apply_binary(mul, 6, 7) != 42 { return 2 }
	increment: UnaryOp = (value: i32) -> i32 { return value + 1 }
	if increment(41) != 42 { return 36 }

	chosen := choose_binary(false)
	if chosen(39, 3) != 42 { return 3 }
	chosen = choose_binary(true)
	if chosen(7, 6) != 42 { return 4 }

	unary: UnaryOp = square
	if apply_unary(unary, 6) != 36 { return 5 }
	unary = negate
	if unary(9) != -9 { return 6 }

	; Function pointers remain ordinary values in arrays and structs.
	ops: BinaryOp[2] = [add, mul]
	selected: BinaryOp = ops[0]
	if selected(10, 32) != 42 { return 7 }
	selected = ops[1]
	if selected(6, 7) != 42 { return 8 }
	if ops[0](40, 2) != 42 { return 11 }

	calc: Calculator = Calculator { .combine = add, .transform = square }
	if run_calculator(calc, 4, 2) != 36 { return 9 }
	calc.combine = mul
	calc.transform = negate
	if run_calculator(calc, 7, 6) != -42 { return 10 }

	; --- Qualified modules, imported impl methods, and imported bounds ---
	if mathlib.triple(14) != 42 { return 12 }
	if mathlib.inc(mathlib.BIAS) != 41 { return 13 }

	offset: mathlib.Offset = { .value = 2 }
	if offset.apply(40) != 42 { return 29 }
	if apply_imported<mathlib.Offset>(&offset, 40) != 42 { return 30 }

	bounded_offset: mathlib.BoundOffset<mathlib.Offset> = { .item = offset }
	if bounded_offset.item.value != 2 { return 31 }

	; --- Cross-module generics ---
	; The importer specializes an imported generic into its own object; the
	; template's own calls stay linked to the module that exported it.
	if mathlib.bumped_max<i32>(19, 23) != 24 { return 52 }
	if mathlib.bumped_max(1, 2) != 3 { return 53 }

	; --- Iterating a user type through its `len`/`at` contract ---
	lane: mathlib.Lane = { .. }
	lane.used = mathlib.LANES as i64
	lane.slots[0] = 20
	lane.slots[1] = 15
	lane.slots[2] = 7
	if mathlib.total_of<mathlib.Lane>(&lane) != 42 { return 54 }

	; A constant array length in type position: `const` and associated constants.
	tally: i32[mathlib.LANES] = [0, 0, 0]
	for value in lane {
		tally[0] += value
	}
	if tally[0] != 42 { return 55 }

	; --- Destructuring and explicit manual vtables ---
	box: Shape = Shape.make(6, 7)
	{ width, h = height } := box
	if width * h != 42 { return 35 }

	; --- Buffer-based string interpolation (never allocates) ---
	fmt_buf: u8[32] = []
	formatted := string.format_into(fmt_buf[..], "w={width} h={h}")
	match formatted {
		Ok(n) -> {
			if n != 7 { return 48 }
		}
		Err(_) -> {
			return 49
		}
	}

	rect_vt: ShapeVTable = ShapeVTable { .area = rect_area, .perimeter = rect_perimeter }
	obj: ShapeObj = ShapeObj { .data = &box, .vtable = &rect_vt }
	if shape_area(&obj) != 42 { return 14 }
	if shape_perimeter(&obj) != 26 { return 15 }

	; --- Impl methods and statically dispatched interface bounds ---
	if box.area() != 42 { return 16 }
	if box.scaled_area(3) != 126 { return 17 }
	if box.perimeter_value() != 26 { return 28 }

	disc: Disc = Disc { .radius = 3 }
	if double_area<Shape>(&box) != 84 { return 18 }
	if double_area<Disc>(&disc) != 54 { return 19 }
	if scaled_area<Disc>(&disc, 2) != 54 { return 27 }

	; Bounds also apply to structs, aliases, and enum payloads.
	measured: Measured<Shape> = { .value = &box }
	if measured.value.area() != 42 { return 32 }

	measured_ptr: MeasuredPtr<Shape> = &box
	if measured_ptr.width * measured_ptr.height != 42 { return 33 }

	maybe: MaybeMeasured<Shape> = MaybeMeasured.Present(box)
	maybe_area := match maybe {
		MaybeMeasured.Present(value) -> value.area()
		MaybeMeasured.Missing -> 0
	}
	if maybe_area != 42 { return 34 }

	; A literal must name every field unless `..` zero-fills the rest.
	flat: Shape = { .width = 6, .. }
	if flat.width != 6 or flat.height != 0 { return 51 }

	; --- Qualified enum variants ---
	link: Link = Link.Busy(40)
	spindle: Spindle = Spindle.Busy(2)
	link_load := match link {
		Busy(n) -> n
		Idle -> 0
	}
	spindle_load := match spindle {
		Busy(n) -> n
		Spun -> 0
	}
	if link_load + spindle_load != 42 { return 50 }

	; --- Associated constants and type aliases ---
	corners: Shape.Pair = [Shape.SIDES, Shape.SIDES * 10]
	if corners[0] + corners[1] != 44 { return 37 }
	if Measured<Shape>.TAG != 7 { return 38 }

	; --- Runtime interface dispatch through built-in wide pointers ---
	mixed: dyn Measurable[2] = [(&box) as dyn Measurable, (&disc) as dyn Measurable]
	if mixed[1].area() != 27 { return 25 }
	if sum_areas(&mixed[0], 2) != 69 { return 26 }

	; --- Literal match patterns ---
	if eval_op(OP_ADD, 40, 2) != 42 { return 20 }
	if eval_op(OP_MUL, 6, 7) != 42 { return 21 }
	if eval_op(99, 1, 1) != -1 { return 22 }
	if classify_char('*') != OP_MUL { return 23 }
	if classify_char('x') != 'x' { return 24 }

	; --- Compile-time layout reflection ---
	if size_of<Shape>() != 8 { return 39 }
	if align_of<Shape>() != 4 { return 40 }
	if size_of<Measured<Shape>>() != 8 { return 41 }

	heap_status := showcase_heap()
	if heap_status != 0 { return heap_status }

	console.println("HLL2 showcase: all checks passed")
	return 0
}
