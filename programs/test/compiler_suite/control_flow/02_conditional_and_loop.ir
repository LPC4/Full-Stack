define control_suite($param: i32) -> i32 {
entry:
    $param_ptr = stack_alloc i32
    store i32 $param, $param_ptr
    ; local var: sum
    $sum = stack_alloc i32
    store i32 0, $sum
    jump while_cond_0
while_cond_0:
    $0 = load i32, $param_ptr
    $1 = cmp sgt i32 $0, 0
    branch $1 ? while_body_1 : while_exit_2
while_body_1:
    $2 = load i32, $param_ptr
    $3 = cmp eq i32 $2, 5
    branch $3 ? if_then_3 : if_else_4
if_then_3:
    $4 = load i32, $sum
    $5 = add i32 $4, 10
    store i32 $5, $sum
    jump if_merge_5
if_else_4:
    $6 = load i32, $sum
    $7 = add i32 $6, 1
    store i32 $7, $sum
    jump if_merge_5
if_merge_5:
    $8 = load i32, $param_ptr
    $9 = sub i32 $8, 1
    store i32 $9, $param_ptr
    jump while_cond_0
while_exit_2:
    $10 = load i32, $sum
    $11 = cmp sgt i32 $10, 0
    branch $11 ? if_then_6 : if_merge_8
if_then_6:
    $12 = load i32, $sum
    ret $12
if_merge_8:
    ret 0
}