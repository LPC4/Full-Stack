define main() -> i32 {
entry:
    ; local var: c
    $c = stack_alloc i32
    $0 = add i32 10, 20
    store i32 $0, $c
    jump while_cond_0
while_cond_0:
    $1 = load i32, $c
    $2 = cmp slt i32 $1, 50
    branch $2 ? while_body_1 : while_exit_2
while_body_1:
    $3 = load i32, $c
    $4 = add i32 $3, 1
    store i32 $4, $c
    $5 = load i32, $c
    $6 = cmp eq i32 $5, 40
    branch $6 ? if_then_3 : if_merge_5
if_then_3:
    jump while_exit_2
if_merge_5:
    $7 = load i32, $c
    $8 = cmp eq i32 $7, 35
    branch $8 ? if_then_6 : if_merge_8
if_then_6:
    jump while_cond_0
if_merge_8:
    jump while_cond_0
while_exit_2:
    $9 = load i32, $c
    ret $9
}