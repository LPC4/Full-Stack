type Point = { x: f32, y: f32 }

define calc_offset($p: Point*, $shift: f32) -> f32 {
entry:
    $p_ptr = stack_alloc Point*
    store Point* $p, $p_ptr
    $shift_ptr = stack_alloc f32
    store f32 $shift, $shift_ptr
    $0 = load { x: f32, y: f32 }*, $p_ptr
    ; Address of field 'x' at offset 0
    $1 = offset f32 $0, 0
    $2 = load { x: f32, y: f32 }*, $p_ptr
    ; Access field 'x' at offset 0
    $3 = load f32, $2 + 0
    $4 = load f32, $shift_ptr
    $5 = add f32 $3, $4
    store f32 $5, $1
    $6 = load { x: f32, y: f32 }*, $p_ptr
    ; Address of field 'y' at offset 4
    $7 = offset f32 $6, 4
    $8 = load { x: f32, y: f32 }*, $p_ptr
    ; Access field 'y' at offset 4
    $9 = load f32, $8 + 4
    $10 = load f32, $shift_ptr
    $11 = add f32 $9, $10
    store f32 $11, $7
    $12 = load { x: f32, y: f32 }*, $p_ptr
    ; Access field 'x' at offset 0
    $13 = load f32, $12 + 0
    $14 = load { x: f32, y: f32 }*, $p_ptr
    ; Access field 'y' at offset 4
    $15 = load f32, $14 + 4
    $16 = mul f32 $13, $15
    ret $16
}