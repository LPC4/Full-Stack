define divide($a: i32, $b: i32) -> { quotient: i32, remainder: i32 } {
entry:
    $a_ptr = stack_alloc i32
    store i32 $a, $a_ptr
    $b_ptr = stack_alloc i32
    store i32 $b, $b_ptr
    $0 = load i32, $a_ptr
    $1 = load i32, $b_ptr
    $2 = sdiv i32 $0, $1
    $3 = load i32, $a_ptr
    $4 = load i32, $b_ptr
    $5 = mod i32 $3, $4
    $6 = stack_alloc { quotient: i32, remainder: i32 }
    store i32 $2, $6 + 0
    store i32 $5, $6 + 4
    ret $6
}

define test_tuple_destructuring() -> i32 {
entry:
    $0 = call divide(10, 3)
    $1 = stack_alloc { quotient: i32, remainder: i32 }
    store { quotient: i32, remainder: i32 } $0, $1
    $2 = load i32, $1 + 0
    $quotient = stack_alloc i32
    store i32 $2, $quotient
    $3 = load i32, $1 + 4
    $remainder = stack_alloc i32
    store i32 $3, $remainder
    $4 = load i32, $quotient
    ret $4
}