extern print(i32) -> i32

define main() -> i32 {
entry:
    ; local var: signed_a
    $signed_a = stack_alloc i32
    store i32 10, $signed_a
    ; local var: signed_b
    $signed_b = stack_alloc i32
    store i32 3, $signed_b
    ; local var: signed_result
    $signed_result = stack_alloc i32
    $0 = load i32, $signed_a
    $1 = load i32, $signed_b
    $2 = sdiv i32 $0, $1
    store i32 $2, $signed_result
    ; local var: unsigned_a
    $unsigned_a = stack_alloc i32
    store i32 10, $unsigned_a
    ; local var: unsigned_b
    $unsigned_b = stack_alloc i32
    store i32 3, $unsigned_b
    ; local var: unsigned_result
    $unsigned_result = stack_alloc i32
    $3 = load i32, $unsigned_a
    $4 = load i32, $unsigned_b
    $5 = udiv i32 $3, $4
    store i32 $5, $unsigned_result
    ; local var: signed_cmp
    $signed_cmp = stack_alloc i1
    $6 = cmp slt i32 5, 10
    store i1 $6, $signed_cmp
    ; local var: ua
    $ua = stack_alloc i32
    store i32 5, $ua
    ; local var: ub
    $ub = stack_alloc i32
    store i32 10, $ub
    ; local var: unsigned_cmp
    $unsigned_cmp = stack_alloc i1
    $7 = load i32, $ua
    $8 = load i32, $ub
    $9 = cmp ult i32 $7, $8
    store i1 $9, $unsigned_cmp
    ; local var: small
    $small = stack_alloc i32
    store i32 42, $small
    ; local var: big
    $big = stack_alloc i64
    $10 = load i32, $small
    $11 = sext $10 to i64
    store i64 $11, $big
    ; local var: large
    $large = stack_alloc i64
    store i64 100, $large
    ; local var: small_again
    $small_again = stack_alloc i32
    $12 = load i64, $large
    $13 = trunc $12 to i32
    store i32 $13, $small_again
    ; local var: int_val
    $int_val = stack_alloc i32
    store i32 42, $int_val
    ; local var: float_val
    $float_val = stack_alloc f64
    $14 = load i32, $int_val
    $15 = i2f $14 to f64
    store f64 $15, $float_val
    ; local var: ptr
    $ptr = stack_alloc i32*
    $16 = heap_alloc i32
    store i32* $16, $ptr
    $17 = load i32*, $ptr
    store i32 99, $17
    ; local var: heap_value
    $heap_value = stack_alloc i32
    $18 = load i32*, $ptr
    $19 = load i32, $18
    store i32 $19, $heap_value
    $20 = load i32*, $ptr
    heap_free $20
    ; local var: int_ptr
    $int_ptr = stack_alloc i32*
    $21 = heap_alloc i32
    store i32* $21, $int_ptr
    ; local var: byte_ptr
    $byte_ptr = stack_alloc i8*
    $22 = load i32*, $int_ptr
    $23 = bitcast $22 to i8*
    store i8* $23, $byte_ptr
    $24 = load i32*, $int_ptr
    heap_free $24
    $25 = load i32, $signed_result
    $26 = load i32, $unsigned_result
    $27 = zext $26 to i32
    $28 = add i32 $25, $27
    $29 = load i32, $heap_value
    $30 = add i32 $28, $29
    ret $30
}