define factorial($n: i32) -> i32 {
entry:
    $n_ptr = stack_alloc i32
    store i32 $n, $n_ptr
    $0 = load i32, $n_ptr
    $1 = cmp sle i32 $0, 1
    branch $1 ? if_then_0 : if_merge_2
if_then_0:
    ret 1
if_merge_2:
    $2 = load i32, $n_ptr
    $3 = load i32, $n_ptr
    $4 = sub i32 $3, 1
    $5 = call factorial($4)
    $6 = mul i32 $2, $5
    ret $6
}

define fibonacci($n: i32) -> i32 {
entry:
    $n_ptr = stack_alloc i32
    store i32 $n, $n_ptr
    $0 = load i32, $n_ptr
    $1 = cmp sle i32 $0, 0
    branch $1 ? if_then_3 : if_merge_5
if_then_3:
    ret 0
if_merge_5:
    $2 = load i32, $n_ptr
    $3 = cmp eq i32 $2, 1
    branch $3 ? if_then_6 : if_merge_8
if_then_6:
    ret 1
if_merge_8:
    $4 = load i32, $n_ptr
    $5 = sub i32 $4, 1
    $6 = call fibonacci($5)
    $7 = load i32, $n_ptr
    $8 = sub i32 $7, 2
    $9 = call fibonacci($8)
    $10 = add i32 $6, $9
    ret $10
}

define add_multiply($a: i32, $b: i32, $c: i32) -> i32 {
entry:
    $a_ptr = stack_alloc i32
    store i32 $a, $a_ptr
    $b_ptr = stack_alloc i32
    store i32 $b, $b_ptr
    $c_ptr = stack_alloc i32
    store i32 $c, $c_ptr
    $0 = load i32, $a_ptr
    $1 = load i32, $b_ptr
    $2 = add i32 $0, $1
    $3 = load i32, $c_ptr
    $4 = mul i32 $2, $3
    ret $4
}

define max_value($a: i32, $b: i32) -> i32 {
entry:
    $a_ptr = stack_alloc i32
    store i32 $a, $a_ptr
    $b_ptr = stack_alloc i32
    store i32 $b, $b_ptr
    $0 = load i32, $a_ptr
    $1 = load i32, $b_ptr
    $2 = cmp sgt i32 $0, $1
    branch $2 ? if_then_9 : if_merge_11
if_then_9:
    $3 = load i32, $a_ptr
    ret $3
if_merge_11:
    $4 = load i32, $b_ptr
    ret $4
}

define main() -> void {
entry:
    call print(120)
    call print(3628800)
    call print(55)
    call print(20)
    call print(42)
    call print(40320)
    ret
}