define chained_deref_assign($val: i32) -> i32 {
entry:
    $val_ptr = stack_alloc i32
    store i32 $val, $val_ptr
    ; local var: ptr
    $ptr = stack_alloc i32*
    $0 = heap_alloc i32
    store i32* $0, $ptr
    ; local var: pp
    $pp = stack_alloc i32**
    store i32** $ptr, $pp
    $1 = load i32**, $pp
    $2 = load i32*, $1
    $3 = load i32, $val_ptr
    $4 = add i32 $3, 1
    store i32 $4, $2
    $5 = load i32*, $ptr
    ; defer: captured call free with 1 args
    $6 = load i32*, $ptr
    $7 = load i32, $6
    ; executing deferred cleanup before return
    call free($5)
    ret $7
}