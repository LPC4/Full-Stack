define pointers($val: i32) -> i32 {
entry:
    $val_ptr = stack_alloc i32
    store i32 $val, $val_ptr
    ; local var: ptr
    $ptr = stack_alloc i32*
    $0 = heap_alloc i32
    store i32* $0, $ptr
    $1 = load i32*, $ptr
    $2 = load i32, $val_ptr
    store i32 $2, $1
    ; local var: val_ref
    $val_ref = stack_alloc i32*
    store i32* $val_ptr, $val_ref
    $3 = load i32*, $val_ref
    $4 = load i32*, $ptr
    $5 = load i32, $4
    $6 = add i32 $5, 10
    store i32 $6, $3
    $7 = load i32*, $ptr
    ; defer: captured call free with 1 args
    $8 = load i32, $val_ptr
    ; executing deferred cleanup before return
    call free($7)
    ret $8
}