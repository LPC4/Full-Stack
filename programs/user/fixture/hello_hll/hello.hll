; HLL-0 cc reference. The host comparison supplies putc through the console module.
; Prints "HLL0\nY", exits sum_to(8)=36.

console := import("console")

putc: (ch: i32) -> i32 {
    console.putchar(ch)
    return 0
}

sum_to: (n: i32) -> i32 {
    total: i32 = 0
    i: i32 = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

main: () -> i32 {
    putc('H')
    putc('L')
    putc('L')
    putc('0')
    putc('\n')
    n: i32 = sum_to(8)
    if n > 30 {
        putc('Y')
    }
    return n
}
