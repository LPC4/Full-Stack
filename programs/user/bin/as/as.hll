; In-VM RV64I assembler: `as <src> <out>`.

console := import("console")
sys := import("sys")
cstr := import("cstr")
object := import("./as_object.hll")
text := import("text")
runtime := import("runtime")

const USER_CODE_BASE = 0x40000000
const HDR = 4096
const PAD = 32

struct Token {
    bytes: u8[24],
    len: u64,
}

struct MemOperand {
    imm: i64,
    reg: i64,
}

enum Directive {
    Text
    Data
    Rodata
    Bss
    Section
    Globl
    Byte
    Word
    Zero
    Asciz
    Ascii
    Unknown
}

enum Opcode {
    Add
    Addi
    Addiw
    And
    Andi
    Auipc
    Beq
    Bge
    Bgeu
    Blt
    Bltu
    Bne
    Call
    Div
    Divu
    Ecall
    J
    Jal
    Jalr
    La
    Lb
    Lbu
    Ld
    Lh
    Lhu
    Li
    Lui
    Lw
    Lwu
    Mul
    Mv
    Nop
    Or
    Ori
    Rem
    Remu
    Ret
    Sb
    Sd
    Sh
    Sll
    Slli
    Slt
    Slti
    Sltiu
    Sltu
    Sra
    Srai
    Srl
    Srli
    Sub
    Sw
    Xor
    Xori
    Unknown
}

; --- Assembly state ---
src: u8* = null
src_len: u64 = 0
export code: u8* = null
export code_len: u64 = 0
export data: u8* = null
export data_len: u64 = 0
cur_sec: Section = Section.TextSection
text_total: i64 = 0
export out: u8* = null

export labels: Label* = null
export lbl_count: i64 = 0
tokbuf: Token* = null
ntok: i64 = 0
err_flag: i64 = 0

; --- Object mode ---
obj_mode: i64 = 0
glbl_names: u8* = null
glbl_count: i64 = 0
export relocs: Reloc* = null
export nreloc: i64 = 0

tok_at: (i: i64) -> u8[] {
    token: Token* = tokbuf + i
    empty: u8[1] = []
    view: u8[] = empty[0..0]
    view.ptr = token as u8*
    view.len = token.len
    return view
}

export fail: (msg: u8*) {
    console.write("as: ".ptr)
    console.writeln(msg)
    err_flag = 1
}

is_sep: (c: u8) -> i64 {
    return match c {
        ' '  -> 1
        '\t' -> 1
        ','  -> 1
        _    -> 0
    }
}

strip_comment: (line: u8[]) -> u8[] {
    for i in 0..line.len {
        c: u8 = line[i]
        if c == ';' {
            return line[0..i]
        }
        if c == '#' {
            return line[0..i]
        }
    }
    return line
}

tokenize: (line: u8[]) {
    for slot in 0..6 {
        token: Token* = tokbuf + slot
        token.len = 0
    }
    n: i64 = 0
    i: u64 = 0
    while i < line.len {
        while i < line.len {
            if is_sep(line[i]) == 0 {
                break
            }
            i = i + 1
        }
        if i == line.len {
            break
        }
        if n >= 6 {
            break
        }
        token: Token* = tokbuf + n
        dst: u8* = token as u8*
        k: u64 = 0
        while i < line.len {
            c: u8 = line[i]
            if is_sep(c) == 1 {
                break
            }
            if k < 23 {
                d: u8* = dst + k
                @d = c
                k = k + 1
            }
            i = i + 1
        }
        token.len = k
        n = n + 1
    }
    ntok = n
}

ends_colon: (token: u8[]) -> i64 {
    if token.len == 0 {
        return 0
    }
    if token[token.len - 1] == ':' {
        return 1
    }
    return 0
}

drop_colon: (token: u8[]) -> u8[] {
    return token[0..token.len - 1]
}

; --- Register and immediate parsing ---

parse_uint: (token: u8[]) -> i64 {
    v: i64 = 0
    for i in 0..token.len {
        c: u8 = token[i]
        if c < '0' {
            return v
        }
        if c > '9' {
            return v
        }
        v = v * 10 + (c as i64 - '0')
    }
    return v
}

reg_num: (token: u8[]) -> i64 {
    if token.len == 4 {
        if token[0] == 'z' && token[1] == 'e' && token[2] == 'r' && token[3] == 'o' {
            return 0
        }
    }
    if token.len == 2 {
        first: u8 = token[0]
        second: u8 = token[1]
        if first == 'r' && second == 'a' { return 1 }
        if first == 's' && second == 'p' { return 2 }
        if first == 'g' && second == 'p' { return 3 }
        if first == 't' && second == 'p' { return 4 }
        if first == 'f' && second == 'p' { return 8 }
        if second >= '0' && second <= '9' {
            digit: i64 = (second - '0') as i64
            if first == 't' {
                if digit <= 2 { return digit + 5 }
                if digit <= 6 { return digit + 25 }
            }
            if first == 'a' && digit <= 7 { return digit + 10 }
            if first == 's' {
                if digit <= 1 { return digit + 8 }
                return digit + 16
            }
            if first == 'x' && digit <= 9 { return digit }
        }
    }
    if token.len == 3 {
        if token[0] == 's' && token[1] == '1' {
            if token[2] == '0' { return 26 }
            if token[2] == '1' { return 27 }
        }
        if token[0] == 'x' {
            n: i64 = parse_uint(token[1..])
            if n <= 31 { return n }
        }
    }
    fail("bad register".ptr)
    return -1
}

parse_imm: (token: u8[]) -> i64 {
    i: u64 = 0
    neg: i64 = 0
    if i < token.len {
        if token[i] == '-' {
            neg = 1
            i = i + 1
        }
    }
    v: i64 = 0
    if i < token.len {
        if token[i] == '0' {
        if i + 1 < token.len {
        if token[i + 1] == 'x' {
            i = i + 2
            while i < token.len {
                c: u8 = token[i]
                d: i64 = -1
                if c >= '0' {
                    if c <= '9' {
                        d = c as i64 - '0'
                    }
                }
                if c >= 'a' {
                    if c <= 'f' {
                        d = c as i64 - 87
                    }
                }
                if c >= 'A' {
                    if c <= 'F' {
                        d = c as i64 - 55
                    }
                }
                if d < 0 {
                    break
                }
                v = v * 16 + d
                i = i + 1
            }
            if neg == 1 {
                return 0 - v
            }
            return v
        }
        }
        }
    }
    while i < token.len {
        c: u8 = token[i]
        if c < '0' {
            break
        }
        if c > '9' {
            break
        }
        v = v * 10 + (c as i64 - '0')
        i = i + 1
    }
    if neg == 1 {
        return 0 - v
    }
    return v
}

parse_mem: (token: u8[]) -> MemOperand {
    imm: i64 = parse_imm(token)
    i: u64 = 0
    while i < token.len {
        if token[i] == '(' {
            break
        }
        i = i + 1
    }
    if i == token.len {
        fail("bad memory operand".ptr)
        return { .imm = imm, .reg = 0 }
    }
    i = i + 1
    start: u64 = i
    k: u64 = 0
    while i < token.len {
        c: u8 = token[i]
        if c == ')' {
            break
        }
        k = k + 1
        i = i + 1
    }
    return { .imm = imm, .reg = reg_num(token[start..start + k]) }
}

; --- Label table ---

add_label: (name: u8[], off: i64, sec: Section) {
    if lbl_count >= 64 {
        fail("too many labels".ptr)
        return
    }
    lab: Label* = &labels[lbl_count]
    dst: u8* = lab as u8*
    text.copy_name16(dst, name)
    lab.addr = off
    lab.sec = sec
    lbl_count = lbl_count + 1
}

resolve_labels: () {
    i: i64 = 0
    while i < lbl_count {
        lab: Label* = &labels[i]
        match lab.sec {
            TextSection -> {}
            DataSection -> {
                lab.addr = text_total + PAD + lab.addr
            }
        }
        i = i + 1
    }
}

find_label: (name: u8[]) -> i64 {
    i: i64 = 0
    while i < lbl_count {
        lab: Label* = &labels[i]
        cand: u8* = lab as u8*
        if cstr.eq_slice(cstr.view(cand, 16), name) == 1 {
            return lab.addr
        }
        i = i + 1
    }
    fail("undefined label".ptr)
    return -1
}

export label_defined: (name: u8[]) -> i64 {
    i: i64 = 0
    while i < lbl_count {
        lab: Label* = &labels[i]
        cand: u8* = lab as u8*
        if cstr.eq_slice(cstr.view(cand, 16), name) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

add_globl: (name: u8[]) {
    if is_globl(name) == 1 {
        return
    }
    if glbl_count >= 32 {
        return
    }
    dst: u8* = glbl_names + (glbl_count as u64) * 16
    text.copy_name16(dst, name)
    glbl_count = glbl_count + 1
}

export is_globl: (name: u8[]) -> i64 {
    i: i64 = 0
    while i < glbl_count {
        cand: u8* = glbl_names + (i as u64) * 16
        if cstr.eq_slice(cstr.view(cand, 16), name) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

add_reloc: (name: u8[], off: i64, kind: RelocKind) {
    if nreloc >= 256 {
        fail("too many relocations".ptr)
        return
    }
    r: Reloc* = &relocs[nreloc]
    dst: u8* = r as u8*
    text.copy_name16(dst, name)
    r.off = off
    r.kind = kind
    nreloc = nreloc + 1
}

; --- Encoding ---

push_byte: (b: u8) {
    if code_len < 8192 {
        code[code_len] = b
        code_len = code_len + 1
    }
}

emit_word: (w: u32) {
    push_byte(w as u8)
    push_byte((w >> 8) as u8)
    push_byte((w >> 16) as u8)
    push_byte((w >> 24) as u8)
}

export wr_le: (off: u64, val: u64, n: u64) {
    k: u64 = 0
    while k < n {
        d: u8* = out + off + k
        @d = (val >> (k * 8)) as u8
        k = k + 1
    }
}

enc_r: (rd: i64, rs1: i64, rs2: i64, funct3: i64, funct7: i64) -> u32 {
    return ((funct7 as u32) << 25) | ((rs2 as u32) << 20) | ((rs1 as u32) << 15)
         | ((funct3 as u32) << 12) | ((rd as u32) << 7) | (0x33 as u32)
}

enc_i: (rd: i64, rs1: i64, imm: i64, funct3: i64, opcode: i64) -> u32 {
    return (((imm as u32) & 0xFFF) << 20) | ((rs1 as u32) << 15)
         | ((funct3 as u32) << 12) | ((rd as u32) << 7) | (opcode as u32)
}

enc_b: (rs1: i64, rs2: i64, imm: i64, funct3: i64) -> u32 {
    u: u32 = imm as u32
    i12: u32 = (u >> 12) & 1
    i11: u32 = (u >> 11) & 1
    i10_5: u32 = (u >> 5) & 0x3F
    i4_1: u32 = (u >> 1) & 0xF
    return (i12 << 31) | (i10_5 << 25) | ((rs2 as u32) << 20) | ((rs1 as u32) << 15)
         | ((funct3 as u32) << 12) | (i4_1 << 8) | (i11 << 7) | (0x63 as u32)
}

enc_j: (rd: i64, imm: i64) -> u32 {
    u: u32 = imm as u32
    i20: u32 = (u >> 20) & 1
    i10_1: u32 = (u >> 1) & 0x3FF
    i11: u32 = (u >> 11) & 1
    i19_12: u32 = (u >> 12) & 0xFF
    return (i20 << 31) | (i10_1 << 21) | (i11 << 20) | (i19_12 << 12)
         | ((rd as u32) << 7) | (0x6F as u32)
}

enc_s: (rs1: i64, rs2: i64, imm: i64, funct3: i64) -> u32 {
    u: u32 = imm as u32
    i11_5: u32 = (u >> 5) & 0x7F
    i4_0: u32 = u & 0x1F
    return (i11_5 << 25) | ((rs2 as u32) << 20) | ((rs1 as u32) << 15)
         | ((funct3 as u32) << 12) | (i4_0 << 7) | (0x23 as u32)
}

emit_load_operand: (rd: u8[], operand: u8[], funct3: i64) {
    { imm: i64, reg: i64 } = parse_mem(operand)
    emit_word(enc_i(reg_num(rd), reg, imm, funct3, 0x03))
}

emit_store_operand: (rs: u8[], operand: u8[], funct3: i64) {
    { imm: i64, reg: i64 } = parse_mem(operand)
    emit_word(enc_s(reg, reg_num(rs), imm, funct3))
}

enc_u: (rd: i64, imm: i64, opcode: i64) -> u32 {
    return (((imm as u32) & 0xFFFFF) << 12) | ((rd as u32) << 7) | (opcode as u32)
}

li_size: (imm: i64) -> i64 {
    if imm >= -2048 {
        if imm <= 2047 {
            return 4
        }
    }
    return 8
}

emit_li: (rd: i64, imm: i64) {
    if imm >= -2048 {
        if imm <= 2047 {
            emit_word(enc_i(rd, 0, imm, 0, 0x13))
            return
        }
    }
    if imm < 0 {
        fail("li: negative immediate too wide".ptr)
        return
    }
    hi: i64 = (imm + 2048) / 4096
    if hi > 1048575 {
        fail("li: immediate too wide".ptr)
        return
    }
    lo: i64 = imm - hi * 4096
    emit_word(((hi as u32) & 0xFFFFF) << 12 | ((rd as u32) << 7) | (0x37 as u32))
    emit_word(enc_i(rd, rd, lo, 0, 0x13))
}

; --- Data section emission ---

push_data_byte: (b: u8) {
    if data_len < 8192 {
        data[data_len] = b
        data_len = data_len + 1
    }
}

emit_data_word: (w: u32) {
    push_data_byte(w as u8)
    push_data_byte((w >> 8) as u8)
    push_data_byte((w >> 16) as u8)
    push_data_byte((w >> 24) as u8)
}

; PC-relative split for auipc+addi / auipc+jalr pairs.
pcrel_hi: i64 = 0
pcrel_lo: i64 = 0
split_pcrel: (delta: i64) {
    lo: i64 = delta & 0xFFF
    if lo >= 2048 {
        lo = lo - 4096
    }
    pcrel_lo = lo
    pcrel_hi = (delta - lo) >> 12
}

data_string: (pass: i64, line: u8[], zt: i64) -> i64 {
    i: u64 = 0
    while i < line.len {
        if line[i] == '"' {
            break
        }
        i = i + 1
    }
    if i == line.len {
        fail("string: missing quote".ptr)
        return 0
    }
    i = i + 1
    n: i64 = 0
    while i < line.len {
        c: u8 = line[i]
        if c == '"' {
            break
        }
        if c == '\\' {
            i = i + 1
            if i == line.len {
                fail("string: trailing escape".ptr)
                return 0
            }
            e: u8 = line[i]
            c = match e {
                'n'  -> '\n' as u8
                't'  -> '\t' as u8
                'r'  -> '\r' as u8
                '0'  -> 0 as u8
                '\\' -> '\\' as u8
                '"'  -> '"' as u8
                _    -> e
            }
        }
        if pass == 2 {
            push_data_byte(c)
        }
        n = n + 1
        i = i + 1
    }
    if zt == 1 {
        if pass == 2 {
            push_data_byte(0 as u8)
        }
        n = n + 1
    }
    return n
}

token_hash: (token: u8[]) -> u64 {
    hash: u64 = 2166136261
    for byte in token {
        hash = ((hash ^ (byte as u64)) * 16777619) & 0xFFFFFFFF
    }
    return hash
}

decode_directive: (name: u8[]) -> Directive {
    return match token_hash(name) {
        229455399 -> Directive.Bss
        1135569119 -> Directive.Zero
        1301906482 -> Directive.Rodata
        1486807952 -> Directive.Section
        1880857985 -> Directive.Data
        2292723394 -> Directive.Text
        2510560331 -> Directive.Byte
        2672855249 -> Directive.Globl
        3661584689 -> Directive.Word
        3867520260 -> Directive.Ascii
        4186295021 -> Directive.Asciz
        _ -> Directive.Unknown
    }
}

handle_directive: (pass: i64, base: i64, line: u8[]) -> i64 {
    directive: Directive = decode_directive(tok_at(base))
    match directive {
        Directive.Text -> {
            cur_sec = Section.TextSection
            return 0
        }
        Directive.Data -> {
            cur_sec = Section.DataSection
            return 0
        }
        Directive.Rodata -> {
            cur_sec = Section.DataSection
            return 0
        }
        Directive.Bss -> {
            cur_sec = Section.DataSection
            return 0
        }
        Directive.Section -> {
            a: u8[] = tok_at(base + 1)
            if cstr.eq_slice(a, ".text") == 1 {
                cur_sec = Section.TextSection
            } else {
                cur_sec = Section.DataSection
            }
            return 0
        }
        Directive.Globl -> {
            if pass == 1 {
                add_globl(tok_at(base + 1))
            }
            return 0
        }
        Directive.Byte -> {
            if pass == 2 {
                push_data_byte(parse_imm(tok_at(base + 1)) as u8)
            }
            return 1
        }
        Directive.Word -> {
            if pass == 2 {
                emit_data_word(parse_imm(tok_at(base + 1)) as u32)
            }
            return 4
        }
        Directive.Zero -> {
            n: i64 = parse_imm(tok_at(base + 1))
            if pass == 2 {
                k: i64 = 0
                while k < n {
                    push_data_byte(0 as u8)
                    k = k + 1
                }
            }
            return n
        }
        Directive.Asciz -> {
            return data_string(pass, line, 1)
        }
        Directive.Ascii -> {
            return data_string(pass, line, 0)
        }
        Directive.Unknown -> {
            fail("unknown directive".ptr)
            return 0
        }
    }
    return 0
}

decode_opcode: (name: u8[]) -> Opcode {
    return match token_hash(name) {
        254395046 -> Opcode.And
        407142512 -> Opcode.Addiw
        492171374 -> Opcode.Jalr
        632395326 -> Opcode.Nop
        752007166 -> Opcode.Srai
        821323692 -> Opcode.Ret
        894566304 -> Opcode.Sb
        993596020 -> Opcode.Add
        995232018 -> Opcode.Sd
        1032681555 -> Opcode.Lwu
        1062342494 -> Opcode.Sh
        1077001542 -> Opcode.Li
        1093779161 -> Opcode.Lh
        1194444875 -> Opcode.Lb
        1211222494 -> Opcode.La
        1240764167 -> Opcode.Rem
        1246896303 -> Opcode.Sw
        1295110589 -> Opcode.Ld
        1297033412 -> Opcode.Lhu
        1357722663 -> Opcode.Srli
        1365129626 -> Opcode.Lbu
        1435638601 -> Opcode.Lui
        1437780985 -> Opcode.Bge
        1465094407 -> Opcode.Divu
        1473741735 -> Opcode.Addi
        1496191754 -> Opcode.Mv
        1513219636 -> Opcode.Lw
        1563699588 -> Opcode.Or
        1571707747 -> Opcode.Beq
        1821928899 -> Opcode.Auipc
        1862248424 -> Opcode.Bltu
        1876040605 -> Opcode.Sltu
        1908981340 -> Opcode.Bne
        1939311297 -> Opcode.Slli
        1943151081 -> Opcode.Slti
        1953918308 -> Opcode.Bgeu
        1992575245 -> Opcode.Blt
        2527302016 -> Opcode.Ecall
        2786983959 -> Opcode.Ori
        2914888669 -> Opcode.Andi
        3018949801 -> Opcode.Call
        3224913586 -> Opcode.Sll
        3429620606 -> Opcode.Xor
        3510427299 -> Opcode.Sra
        3627576442 -> Opcode.Slt
        3694981108 -> Opcode.Srl
        3696113941 -> Opcode.Sub
        3724398710 -> Opcode.Remu
        3756903144 -> Opcode.Jal
        3838436661 -> Opcode.Xori
        3848448840 -> Opcode.Div
        3951357313 -> Opcode.Mul
        4010556029 -> Opcode.J
        4023052436 -> Opcode.Sltiu
        _ -> Opcode.Unknown
    }
}

encode_instr: (pass: i64, base: i64, pc: i64) -> i64 {
    m: u8[] = tok_at(base)
    o0: u8[] = tok_at(base + 1)
    o1: u8[] = tok_at(base + 2)
    o2: u8[] = tok_at(base + 3)
    opcode: Opcode = decode_opcode(m)

    match opcode {
    Opcode.Ecall -> {
        if pass == 2 {
            emit_word(0x73 as u32)
        }
        return 4
    }
    Opcode.Ret -> {
        if pass == 2 {
            emit_word(enc_i(0, 1, 0, 0, 0x67))
        }
        return 4
    }
    Opcode.Li -> {
        imm: i64 = parse_imm(o1)
        if pass == 2 {
            emit_li(reg_num(o0), imm)
        }
        return li_size(imm)
    }
    Opcode.Mv -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), 0, 0, 0x13))
        }
        return 4
    }
    Opcode.Addi -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 0, 0x13))
        }
        return 4
    }
    Opcode.Addiw -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 0, 0x1B))
        }
        return 4
    }
    Opcode.Add -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 0, 0))
        }
        return 4
    }
    Opcode.Sub -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 0, 0x20))
        }
        return 4
    }
    Opcode.And -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 7, 0))
        }
        return 4
    }
    Opcode.Or -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 6, 0))
        }
        return 4
    }
    Opcode.Xor -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 4, 0))
        }
        return 4
    }
    ; --- M-extension ---
    Opcode.Mul -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 0, 1))
        }
        return 4
    }
    Opcode.Div -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 4, 1))
        }
        return 4
    }
    Opcode.Divu -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 5, 1))
        }
        return 4
    }
    Opcode.Rem -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 6, 1))
        }
        return 4
    }
    Opcode.Remu -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 7, 1))
        }
        return 4
    }
    Opcode.J -> {
        if pass == 2 {
            target: i64 = find_label(o0)
            emit_word(enc_j(0, target - pc))
        }
        return 4
    }
    Opcode.Beq -> {
        if pass == 2 {
            target: i64 = find_label(o2)
            emit_word(enc_b(reg_num(o0), reg_num(o1), target - pc, 0))
        }
        return 4
    }
    Opcode.Bne -> {
        if pass == 2 {
            target: i64 = find_label(o2)
            emit_word(enc_b(reg_num(o0), reg_num(o1), target - pc, 1))
        }
        return 4
    }
    Opcode.Blt -> {
        if pass == 2 {
            target: i64 = find_label(o2)
            emit_word(enc_b(reg_num(o0), reg_num(o1), target - pc, 4))
        }
        return 4
    }
    Opcode.Bge -> {
        if pass == 2 {
            target: i64 = find_label(o2)
            emit_word(enc_b(reg_num(o0), reg_num(o1), target - pc, 5))
        }
        return 4
    }
    Opcode.Bltu -> {
        if pass == 2 {
            target: i64 = find_label(o2)
            emit_word(enc_b(reg_num(o0), reg_num(o1), target - pc, 6))
        }
        return 4
    }
    Opcode.Bgeu -> {
        if pass == 2 {
            target: i64 = find_label(o2)
            emit_word(enc_b(reg_num(o0), reg_num(o1), target - pc, 7))
        }
        return 4
    }

    ; --- Jumps and PC-relative address materialization ---
    Opcode.Jal -> {
        if pass == 2 {
            if obj_mode == 1 {
                if label_defined(o1) == 0 {
                    add_reloc(o1, pc, RelocKind.Jal)
                    emit_word(enc_j(reg_num(o0), 0))
                    return 4
                }
            }
            target: i64 = find_label(o1)
            emit_word(enc_j(reg_num(o0), target - pc))
        }
        return 4
    }
    Opcode.Jalr -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 0, 0x67))
        }
        return 4
    }
    Opcode.Call -> {
        if pass == 2 {
            if obj_mode == 1 {
                if label_defined(o0) == 0 {
                    add_reloc(o0, pc, RelocKind.CallPlt)
                    emit_word(enc_u(1, 0, 0x17))
                    emit_word(enc_i(1, 1, 0, 0, 0x67))
                    return 8
                }
            }
            target: i64 = find_label(o0)
            split_pcrel(target - pc)
            emit_word(enc_u(1, pcrel_hi, 0x17))
            emit_word(enc_i(1, 1, pcrel_lo, 0, 0x67))
        }
        return 8
    }
    ; Object-mode la always relocates because section merging shifts distances.
    Opcode.La -> {
        if pass == 2 {
            rd: i64 = reg_num(o0)
            if obj_mode == 1 {
                add_reloc(o1, pc, RelocKind.PcrelHi20)
                hi: i64 = 0
                lo: i64 = 0
                if label_defined(o1) == 1 {
                    split_pcrel(find_label(o1) - pc)
                    hi = pcrel_hi
                    lo = pcrel_lo
                }
                emit_word(enc_u(rd, hi, 0x17))
                emit_word(enc_i(rd, rd, lo, 0, 0x13))
                return 8
            }
            target: i64 = find_label(o1)
            split_pcrel(target - pc)
            emit_word(enc_u(rd, pcrel_hi, 0x17))
            emit_word(enc_i(rd, rd, pcrel_lo, 0, 0x13))
        }
        return 8
    }

    ; --- Register-register (R-type) ---
    Opcode.Sll -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 1, 0))
        }
        return 4
    }
    Opcode.Srl -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 5, 0))
        }
        return 4
    }
    Opcode.Sra -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 5, 0x20))
        }
        return 4
    }
    Opcode.Slt -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 2, 0))
        }
        return 4
    }
    Opcode.Sltu -> {
        if pass == 2 {
            emit_word(enc_r(reg_num(o0), reg_num(o1), reg_num(o2), 3, 0))
        }
        return 4
    }

    ; --- Register-immediate (I-type, opcode 0x13) ---
    Opcode.Andi -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 7, 0x13))
        }
        return 4
    }
    Opcode.Ori -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 6, 0x13))
        }
        return 4
    }
    Opcode.Xori -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 4, 0x13))
        }
        return 4
    }
    Opcode.Slti -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 2, 0x13))
        }
        return 4
    }
    Opcode.Sltiu -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 3, 0x13))
        }
        return 4
    }

    ; --- Shift-immediate (shamt in the low bits; srai sets funct7=0x20) ---
    Opcode.Slli -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 1, 0x13))
        }
        return 4
    }
    Opcode.Srli -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2), 5, 0x13))
        }
        return 4
    }
    Opcode.Srai -> {
        if pass == 2 {
            emit_word(enc_i(reg_num(o0), reg_num(o1), parse_imm(o2) | 0x400, 5, 0x13))
        }
        return 4
    }

    ; --- Loads (rd, offset(rs1); opcode 0x03) ---
    Opcode.Ld -> {
        if pass == 2 {
            emit_load_operand(o0, o1, 3)
        }
        return 4
    }
    Opcode.Lw -> {
        if pass == 2 {
            emit_load_operand(o0, o1, 2)
        }
        return 4
    }
    Opcode.Lwu -> {
        if pass == 2 {
            emit_load_operand(o0, o1, 6)
        }
        return 4
    }
    Opcode.Lh -> {
        if pass == 2 {
            emit_load_operand(o0, o1, 1)
        }
        return 4
    }
    Opcode.Lhu -> {
        if pass == 2 {
            emit_load_operand(o0, o1, 5)
        }
        return 4
    }
    Opcode.Lb -> {
        if pass == 2 {
            emit_load_operand(o0, o1, 0)
        }
        return 4
    }
    Opcode.Lbu -> {
        if pass == 2 {
            emit_load_operand(o0, o1, 4)
        }
        return 4
    }

    ; --- Stores (rs2, offset(rs1); opcode 0x23) ---
    Opcode.Sd -> {
        if pass == 2 {
            emit_store_operand(o0, o1, 3)
        }
        return 4
    }
    Opcode.Sw -> {
        if pass == 2 {
            emit_store_operand(o0, o1, 2)
        }
        return 4
    }
    Opcode.Sh -> {
        if pass == 2 {
            emit_store_operand(o0, o1, 1)
        }
        return 4
    }
    Opcode.Sb -> {
        if pass == 2 {
            emit_store_operand(o0, o1, 0)
        }
        return 4
    }

    ; --- Upper-immediate (rd, imm20) ---
    Opcode.Lui -> {
        if pass == 2 {
            emit_word(enc_u(reg_num(o0), parse_imm(o1), 0x37))
        }
        return 4
    }
    Opcode.Auipc -> {
        if pass == 2 {
            emit_word(enc_u(reg_num(o0), parse_imm(o1), 0x17))
        }
        return 4
    }

    Opcode.Nop -> {
        if pass == 2 {
            emit_word(enc_i(0, 0, 0, 0, 0x13))
        }
        return 4
    }

    Opcode.Unknown -> {
        fail("unknown instruction".ptr)
        return 0
    }
    }
    return 0
}

assemble: (pass: i64) {
    i: u64 = 0
    tpc: i64 = 0
    dpc: i64 = 0
    cur_sec = Section.TextSection
    line: u8[256] = []
    line_p: u8* = &line[0]
    while i < src_len {
        j: u64 = 0
        while i < src_len {
            c: u8 = src[i]
            i = i + 1
            if c == '\n' {
                break
            }
            if c != '\r' {
                if j < 255 {
                    d: u8* = line_p + j
                    @d = c
                    j = j + 1
                }
            }
        }
        line_view: u8[] = line[0..j]
        clean: u8[] = strip_comment(line_view)
        tokenize(clean)
        if ntok != 0 {
            base: i64 = 0
            first: u8[] = tok_at(0)
            if ends_colon(first) == 1 {
                first = drop_colon(first)
                if pass == 1 {
                    match cur_sec {
                        TextSection -> { add_label(first, tpc, Section.TextSection) }
                        DataSection -> { add_label(first, dpc, Section.DataSection) }
                    }
                }
                base = 1
            }
            if base < ntok {
                d0: u8[] = tok_at(base)
                is_directive: bool = false
                if d0.len > 0 {
                    is_directive = d0[0] == '.'
                }
                if is_directive {
                    sz: i64 = handle_directive(pass, base, clean)
                    match cur_sec {
                        TextSection -> {}
                        DataSection -> { dpc = dpc + sz }
                    }
                } else {
                    size: i64 = encode_instr(pass, base, tpc)
                    tpc = tpc + size
                }
            }
        }
    }
    if pass == 1 {
        text_total = tpc
    }
}

; --- Output ---

ends_dot_o: (path: u8[]) -> i64 {
    if path.len < 2 {
        return 0
    }
    if path[path.len - 2] == '.' {
        if path[path.len - 1] == 'o' {
            return 1
        }
    }
    return 0
}

main: () -> i32 {
    src = new(u8, 8192)
    code = new(u8, 8192)
    data = new(u8, 8192)
    out = new(u8, 32768)
    labels = new(Label, 64)
    tokbuf = new(Token, 6)
    glbl_names = new(u8, 512)
    relocs = new(Reloc, 256)
    if src == null or code == null or data == null or out == null or
        labels == null or tokbuf == null or glbl_names == null or relocs == null {
        console.writeln("as: out of memory".ptr)
        return 1
    }

    arg: u8[] = runtime.arg()
    src_path: u8[128] = []
    out_path: u8[128] = []
    src_pp: u8* = &src_path[0]
    out_pp: u8* = &out_path[0]
    if text.split_two(arg, src_path[..], out_path[..]) == false {
        console.writeln("as: usage: as <src> <out>".ptr)
        return 1
    }

    fd: i64 = sys.open(cstr.view(src_pp, 128), 0)
    if fd < 0 {
        console.write("as: cannot open ".ptr)
        console.writeln(src_pp)
        return 1
    }
    n: i64 = sys.read(fd, src, 0, 8191)
    sys.close(fd)
    if n <= 0 {
        console.writeln("as: empty source".ptr)
        return 1
    }
    src_len = n as u64
    src[src_len] = 0 as u8

    obj_mode = ends_dot_o(cstr.view(out_pp, 128))
    lbl_count = 0
    code_len = 0
    data_len = 0
    err_flag = 0
    glbl_count = 0
    nreloc = 0
    assemble(1)
    if obj_mode == 0 {
        resolve_labels()
    }
    code_len = 0
    data_len = 0
    assemble(2)
    if err_flag != 0 {
        return 1
    }

    if obj_mode == 1 {
        ototal: u64 = object.write_object()
        oofd: i64 = sys.open(cstr.view(out_pp, 128), 2)
        if oofd < 0 {
            console.write("as: cannot create ".ptr)
            console.writeln(out_pp)
            return 1
        }
        sys.write(oofd, out, ototal)
        sys.ftruncate(oofd, ototal)
        sys.close(oofd)
        console.write("as: wrote ".ptr)
        console.writeln(out_pp)
        return 0
    }

    ; Keep speculative fetch past a final ecall on valid NOPs.
    for pad in 0..8 {
        emit_word(0x13 as u32)
    }
    for di in 0..data_len {
        push_byte(data[di])
    }

    base: u64 = USER_CODE_BASE as u64
    out[0] = 0x7F as u8
    out[1] = 69 as u8   ; 'E'
    out[2] = 76 as u8   ; 'L'
    out[3] = 70 as u8   ; 'F'
    out[4] = 2 as u8    ; ELFCLASS64
    out[5] = 1 as u8    ; ELFDATA2LSB (little-endian)
    out[6] = 1 as u8    ; EV_CURRENT
    wr_le(16, 2, 2)              ; e_type = ET_EXEC
    wr_le(18, 243, 2)            ; e_machine = EM_RISCV
    wr_le(20, 1, 4)              ; e_version = EV_CURRENT
    wr_le(24, base, 8)           ; e_entry (text starts at the payload base)
    wr_le(32, 64, 8)            ; e_phoff (program header follows the ELF header)
    ; e_shoff (40) stays 0: no section headers.
    wr_le(48, 5, 4)             ; e_flags (RVC | double-float ABI; informational)
    wr_le(52, 64, 2)            ; e_ehsize
    wr_le(54, 56, 2)            ; e_phentsize
    wr_le(56, 1, 2)            ; e_phnum (one PT_LOAD)
    ; e_shentsize/e_shnum/e_shstrndx (58/60/62) stay 0.

    wr_le(64, 1, 4)            ; p_type = PT_LOAD
    wr_le(68, 7, 4)            ; p_flags = R|W|X
    wr_le(72, HDR as u64, 8)   ; p_offset (payload at the page boundary)
    wr_le(80, base, 8)         ; p_vaddr
    wr_le(88, base, 8)         ; p_paddr
    wr_le(96, code_len, 8)     ; p_filesz
    wr_le(104, code_len, 8)    ; p_memsz (no separate BSS; .zero is in the payload)
    wr_le(112, 4096, 8)        ; p_align

    for i in 0..code_len {
        d: u8* = out + (HDR as u64) + i
        @d = code[i]
    }
    total: u64 = (HDR as u64) + code_len

    ofd: i64 = sys.open(cstr.view(out_pp, 128), 2)
    if ofd < 0 {
        console.write("as: cannot create ".ptr)
        console.writeln(out_pp)
        return 1
    }
    sys.write(ofd, out, total)
    sys.ftruncate(ofd, total)
    sys.close(ofd)

    console.write("as: wrote ".ptr)
    console.writeln(out_pp)
    return 0
}
