; Userspace syscall wrappers.
; Numbers and semantics: OS spec ch.7.

struct ExecRequest {
	path_ptr: u8*,
	path_len: u64,
	arg_ptr: u8*,
	arg_len: u64,
	out_fd: i64,
	in_fd: i64,
}

export sys_readchar: () -> i64 {
	result: i64 = 0
	asm {
		li a7, 100
		ecall
		mv $result, a0
	}
	return result
}

export sys_yield: () {
	asm {
		li a7, 2
		ecall
	}
}

export sys_exit: (code: i64) {
	asm {
		mv a0, $code
		li a7, 93
		ecall
	}
}

export sys_open: (path: u8[], flags: u64) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $path.ptr
		mv a1, $path.len
		mv a2, $flags
		li a7, 56
		ecall
		mv $result, a0
	}
	return result
}

export sys_read: (fd: i64, buf: u8*, offset: u64, len: u64) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $fd
		mv a1, $buf
		mv a2, $offset
		mv a3, $len
		li a7, 63
		ecall
		mv $result, a0
	}
	return result
}

export sys_write: (fd: i64, buf: u8*, len: u64) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $fd
		mv a1, $buf
		mv a2, $len
		li a7, 64
		ecall
		mv $result, a0
	}
	return result
}

export sys_close: (fd: i64) {
	asm {
		mv a0, $fd
		li a7, 57
		ecall
	}
}

export sys_ftruncate: (fd: i64, len: u64) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $fd
		mv a1, $len
		li a7, 46
		ecall
		mv $result, a0
	}
	return result
}

export sys_lseek: (fd: i64, offset: i64, whence: u64) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $fd
		mv a1, $offset
		mv a2, $whence
		li a7, 62
		ecall
		mv $result, a0
	}
	return result
}

export sys_stat: (path: u8[]) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $path.ptr
		mv a1, $path.len
		li a7, 102
		ecall
		mv $result, a0
	}
	return result
}

export sys_readdir: (path: u8[], index: u64, name_buf: u8[]) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $path.ptr
		mv a1, $path.len
		mv a2, $index
		mv a3, $name_buf.ptr
		mv a4, $name_buf.len
		li a7, 101
		ecall
		mv $result, a0
	}
	return result
}

export sys_exec_arg: (path: u8[], arg: u8[]) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $path.ptr
		mv a1, $path.len
		mv a2, $arg.ptr
		mv a3, $arg.len
		li a7, 103
		ecall
		mv $result, a0
	}
	return result
}

export sys_exec: (path: u8[]) -> i64 {
	empty: u8[1] = []
	return sys_exec_arg(path, empty[0..0])
}

export sys_exec_redir: (path: u8[], arg: u8[], out_fd: i64, in_fd: i64) -> i64 {
	request: ExecRequest = ExecRequest {
		.path_ptr = path.ptr,
		.path_len = path.len,
		.arg_ptr = arg.ptr,
		.arg_len = arg.len,
		.out_fd = out_fd,
		.in_fd = in_fd,
	}
	result: i64 = 0
	asm {
		la a0, $request
		li a7, 110
		ecall
		mv $result, a0
	}
	return result
}

export sys_mkdir: (path: u8[]) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $path.ptr
		mv a1, $path.len
		li a7, 83
		ecall
		mv $result, a0
	}
	return result
}

export sys_rename: (old_path: u8[], new_path: u8[]) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $old_path.ptr
		mv a1, $old_path.len
		mv a2, $new_path.ptr
		mv a3, $new_path.len
		li a7, 82
		ecall
		mv $result, a0
	}
	return result
}

export sys_unlink: (path: u8[]) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $path.ptr
		mv a1, $path.len
		li a7, 105
		ecall
		mv $result, a0
	}
	return result
}

export sys_rmdir: (path: u8[]) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $path.ptr
		mv a1, $path.len
		li a7, 106
		ecall
		mv $result, a0
	}
	return result
}

export sys_pidalive: (pid: u64) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $pid
		li a7, 104
		ecall
		mv $result, a0
	}
	return result
}

export sys_map_fb: () -> u64 {
	result: u64 = 0
	asm {
		li a7, 107
		ecall
		mv $result, a0
	}
	return result
}

export sys_poll_key: () -> i64 {
	result: i64 = 0
	asm {
		li a7, 108
		ecall
		mv $result, a0
	}
	return result
}

export sys_fork: () -> i64 {
	result: i64 = 0
	asm {
		li a7, 220
		ecall
		mv $result, a0
	}
	return result
}

export sys_wait: () -> i64 {
	result: i64 = 0
	asm {
		li a7, 260
		ecall
		mv $result, a0
	}
	return result
}

export sys_waitpid: (pid: i64) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $pid
		li a7, 261
		ecall
		mv $result, a0
	}
	return result
}

export sys_kill: (pid: i64, sig: i64) -> i64 {
	result: i64 = 0
	asm {
		mv a0, $pid
		mv a1, $sig
		li a7, 129
		ecall
		mv $result, a0
	}
	return result
}
