; Hosted raw memory source (U-mode only): grows the program break via the brk
; syscall (214). The shared allocator in core/memory_allocator.hll sits on top.

; Next free byte and the current break (mapped ceiling). 0 = uninitialised.
heap_cur: u64 = 0
heap_top: u64 = 0

; brk argument/return scratch (inline asm cannot reach locals).
_brk_a0:  u64 = 0
_brk_ret: u64 = 0

; brk(addr): move the program break to `addr` (0 queries it). Returns `addr` on
; success, the unchanged break on failure. Syscall 214.
export heap_brk: (addr: u64) -> u64 {
	_brk_a0 = addr
	asm {
		la t0, _brk_a0
		ld a0, 0(t0)
		li a7, 214
		ecall
		la t0, _brk_ret
		sd a0, 0(t0)
	}
	return _brk_ret
}

; No-op: the hosted source always grows via brk. Present so both heap_source
; variants expose the same interface (the kernel registers its heap region here).
export heap_set_region: (start: u64, end: u64) {
}

; Bump-allocates n bytes, rounded up to 8-byte alignment, raising the break via
; brk (to a page boundary) when the bump pointer would cross it. Null on OOM.
export heap_raw_alloc: (n: u64) -> u8* {
	if n + 7 < n { return null }
	aligned: u64 = ((n + 7) / 8) * 8
	if aligned < n { return null }
	if heap_cur == 0 {
		base: u64 = heap_brk(0)
		heap_cur = base
		heap_top = base
	}
	new_cur: u64 = heap_cur + aligned
	if new_cur < heap_cur { return null }
	if new_cur > heap_top {
		if new_cur + 4095 < new_cur { return null }
		new_top: u64 = ((new_cur + 4095) / 4096) * 4096
		got: u64 = heap_brk(new_top)
		if got < new_top {
			return null
		}
		heap_top = new_top
	}
	ptr: u8* = heap_cur as u8*
	heap_cur = new_cur
	return ptr
}
