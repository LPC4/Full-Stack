; Hosted process entry. User-facing console/syscall APIs live in console/sys modules.
external main: () -> i32
sys := import("sys")

arg_ptr: u8* = null
arg_len: u64 = 0

export runtime_arg: () -> u8[] {
	return { .ptr = arg_ptr, .len = arg_len }
}

export _start: (entry_arg_ptr: u8*, entry_arg_len: u64) {
	arg_ptr = entry_arg_ptr
	arg_len = entry_arg_len
	code: i32 = main()
	sys.exit(code as i64)
}
