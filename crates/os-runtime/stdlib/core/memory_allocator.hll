; Shared aligned, fallible allocator plus standard containers. The raw byte
; source (heap_raw_alloc) is target-specific; see stdlib/*/heap_source.hll.

external heap_raw_alloc: (n: u64) -> u8*

heap_list: HeapBlock* = null

export enum AllocError {
	OutOfMemory
	InvalidAlignment
	SizeOverflow
}

; --- Checked layout helpers ---

; a * b, or SizeOverflow. Shared by every container's capacity arithmetic.
export checked_mul: (a: u64, b: u64) -> Result<u64, AllocError> {
	if a == 0 or b == 0 { return Ok(0) }
	max: u64 = 0
	max -= 1
	if a > max / b { return Err(AllocError.SizeOverflow) }
	return Ok(a * b)
}

; a + b, or SizeOverflow.
export checked_add: (a: u64, b: u64) -> Result<u64, AllocError> {
	total: u64 = a + b
	if total < a { return Err(AllocError.SizeOverflow) }
	return Ok(total)
}

; Byte size of `count` elements of `element_size` bytes; zero-sized elements
; occupy no storage regardless of count.
export array_bytes: (count: u64, element_size: u64) -> Result<u64, AllocError> {
	return checked_mul(count, element_size)
}

; --- Fallible allocation ABI ---

heap_alloc_aligned: (size: u64, align: u64) -> u8* {
	requested: u64 = size
	if requested == 0 {
		return align as u8*
	}

	current: HeapBlock* = heap_list
	while current != null {
		address: u64 = current.ptr as u64
		if current.is_free != 0 and current.size >= requested and address % align == 0 {
			current.is_free = 0
			return current.ptr
		}
		current = current.next
	}

	block: HeapBlock* = heap_raw_alloc(32) as HeapBlock*
	if block == null {
		return null
	}
	padded: u64 = requested + align - 1
	if padded < requested {
		return null
	}
	raw: u8* = heap_raw_alloc(padded)
	if raw == null { return null }
	raw_address: u64 = raw as u64
	payload_address: u64 = ((raw_address + align - 1) / align) * align
	payload: u8* = payload_address as u8*
	@block = {
		.next    = heap_list,
		.ptr     = payload,
		.size    = requested,
		.is_free = 0,
	}
	heap_list = block
	return payload
}

heap_release: (ptr: u8*) {
	if ptr == null {
		return
	}
	current: HeapBlock* = heap_list
	while current != null {
		if current.ptr == ptr {
			current.is_free = 1
			return
		}
		current = current.next
	}
}

export allocate: (size: u64, align: u64) -> Result<u8*, AllocError> {
	if align == 0 or (align & (align - 1)) != 0 {
		return Err(InvalidAlignment)
	}
	if size + align - 1 < size {
		return Err(AllocError.SizeOverflow)
	}
	ptr: u8* = heap_alloc_aligned(size, align)
	if ptr == null { return Err(OutOfMemory) }
	return Ok(ptr)
}

export reallocate: (ptr: u8*, old_size: u64, new_size: u64, align: u64) -> Result<u8*, AllocError> {
	if align == 0 or (align & (align - 1)) != 0 {
		return Err(InvalidAlignment)
	}
	if new_size + align - 1 < new_size {
		return Err(AllocError.SizeOverflow)
	}
	if new_size == 0 {
		heap_release(ptr)
		return Ok(align as u8*)
	}
	replacement: u8* = heap_alloc_aligned(new_size, align)
	if replacement == null { return Err(OutOfMemory) }
	copy_size: u64 = old_size
	if new_size < copy_size { copy_size = new_size }
	i: u64 = 0
	while i < copy_size {
		replacement[i] = ptr[i]
		i += 1
	}
	heap_release(ptr)
	return Ok(replacement)
}

export deallocate: (ptr: u8*, size: u64, align: u64) {
	if size == 0 { return }
	heap_release(ptr)
}

; Compatibility wrappers for callers not yet migrated to the fallible ABI.
export malloc: (size: u64) -> u8* {
	return heap_alloc_aligned(size, 8)
}

export free: (ptr: u8*) {
	heap_release(ptr)
}

; --- Containers ---

export struct Vec<T> {
	ptr: T*,
	len: u64,
	capacity: u64,
}

export impl Vec<T> {
	init: (self: Vec<T>*) {
		self.ptr = align_of<T>() as T*
		self.len = 0
		self.capacity = 0
	}

	reserve: (self: Vec<T>*, required: u64) -> Result<u64, AllocError> {
		if required <= self.capacity { return Ok(self.capacity) }

		max: u64 = 0
		max -= 1
		element_size: u64 = size_of<T>()
		if element_size != 0 and required > max / element_size {
			return Err(AllocError.SizeOverflow)
		}

		new_capacity: u64 = required
		if self.capacity != 0 and self.capacity <= max / 2 {
			doubled: u64 = self.capacity * 2
			if doubled > new_capacity { new_capacity = doubled }
		}
		if element_size != 0 and new_capacity > max / element_size {
			new_capacity = required
		}

		if element_size == 0 {
			self.capacity = new_capacity
			return Ok(new_capacity)
		}

		old_bytes: u64 = self.capacity * element_size
		new_bytes: u64 = 0
		sized := array_bytes(new_capacity, element_size)
		match sized {
			Ok(value) -> { new_bytes = value }
			Err(error) -> { return Err(error) }
		}
		replacement: T* = 0 as T*
		resized := reallocate(
			self.ptr as u8*,
			old_bytes,
			new_bytes,
			align_of<T>(),
		)
		match resized {
			Ok(value) -> { replacement = value as T* }
			Err(error) -> { return Err(error) }
		}
		self.ptr = replacement
		self.capacity = new_capacity
		return Ok(new_capacity)
	}

	push: (self: Vec<T>*, value: T) -> Result<u64, AllocError> {
		needed: u64 = 0
		bumped := checked_add(self.len, 1)
		match bumped {
			Ok(count) -> { needed = count }
			Err(error) -> { return Err(error) }
		}
		reserved := Vec_reserve<T>(self, needed)
		match reserved {
			Ok(capacity) -> {}
			Err(error) -> { return Err(error) }
		}
		if size_of<T>() != 0 {
			self.ptr[self.len] = value
		}
		self.len = needed
		return Ok(self.len)
	}

	pop: (self: Vec<T>*, out: T*) -> bool {
		if self.len == 0 { return false }
		self.len -= 1
		if size_of<T>() != 0 {
			@out = self.ptr[self.len]
		}
		return true
	}

	get: (self: Vec<T>*, index: u64) -> T* {
		if index >= self.len { return 0 as T* }
		return &self.ptr[index]
	}

	clear: (self: Vec<T>*) {
		self.len = 0
	}

	deinit: (self: Vec<T>*) {
		if size_of<T>() != 0 {
			deallocate(
				self.ptr as u8*,
				self.capacity * size_of<T>(),
				align_of<T>(),
			)
		}
		self.ptr = align_of<T>() as T*
		self.len = 0
		self.capacity = 0
	}
}

; UTF-8 well-formedness over raw bytes (overlongs, surrogates, and > U+10FFFF
; rejected). OwnedString runs this before any byte reaches its buffer.
export utf8_valid: (data: u8*, len: u64) -> bool {
	i: u64 = 0
	while i < len {
		b0: u64 = data[i] as u64
		if b0 < 0x80 {
			i += 1
		} else if b0 >= 0xC2 and b0 <= 0xDF {
			if i + 1 >= len { return false }
			b1: u64 = data[i + 1] as u64
			if (b1 & 0xC0) != 0x80 { return false }
			i += 2
		} else if b0 >= 0xE0 and b0 <= 0xEF {
			if i + 2 >= len { return false }
			b1: u64 = data[i + 1] as u64
			b2: u64 = data[i + 2] as u64
			lo: u64 = 0x80
			hi: u64 = 0xBF
			if b0 == 0xE0 { lo = 0xA0 }
			if b0 == 0xED { hi = 0x9F }
			if b1 < lo or b1 > hi { return false }
			if (b2 & 0xC0) != 0x80 { return false }
			i += 3
		} else if b0 >= 0xF0 and b0 <= 0xF4 {
			if i + 3 >= len { return false }
			b1: u64 = data[i + 1] as u64
			b2: u64 = data[i + 2] as u64
			b3: u64 = data[i + 3] as u64
			lo: u64 = 0x80
			hi: u64 = 0xBF
			if b0 == 0xF0 { lo = 0x90 }
			if b0 == 0xF4 { hi = 0x8F }
			if b1 < lo or b1 > hi { return false }
			if (b2 & 0xC0) != 0x80 { return false }
			if (b3 & 0xC0) != 0x80 { return false }
			i += 4
		} else {
			return false
		}
	}
	return true
}

; Allocation failures pass through in `Alloc`; `InvalidUtf8` rejects bad bytes.
export enum StringError {
	Alloc(AllocError)
	InvalidUtf8
}

; Growable UTF-8 string. Every public operation validates incoming bytes, so
; the buffer holds well-formed UTF-8 between calls.
export struct OwnedString {
	bytes: Vec<u8>,
}

export impl OwnedString {
	init: (self: OwnedString*) {
		Vec_init<u8>(&self.bytes)
	}

	from_slice: (self: OwnedString*, data: u8[]) -> Result<u64, StringError> {
		if utf8_valid(&data[0], data.len) == false {
			return Err(InvalidUtf8)
		}
		; Reserve before changing len so allocation failure preserves the old string.
		reserved := Vec_reserve<u8>(&self.bytes, data.len)
		match reserved {
			Ok(capacity) -> {}
			Err(error) -> { return Err(Alloc(error)) }
		}
		i: u64 = 0
		while i < data.len {
			self.bytes.ptr[i] = data[i]
			i += 1
		}
		self.bytes.len = data.len
		return Ok(data.len)
	}

	append: (self: OwnedString*, data: u8[]) -> Result<u64, StringError> {
		if utf8_valid(&data[0], data.len) == false {
			return Err(InvalidUtf8)
		}
		return OwnedString_append_raw(self, data)
	}

	; Bytes are already validated. Reserves once, so state never changes on failure.
	append_raw: (self: OwnedString*, data: u8[]) -> Result<u64, StringError> {
		needed: u64 = 0
		total := checked_add(self.bytes.len, data.len)
		match total {
			Ok(count) -> { needed = count }
			Err(error) -> { return Err(Alloc(error)) }
		}
		reserved := Vec_reserve<u8>(&self.bytes, needed)
		match reserved {
			Ok(capacity) -> {}
			Err(error) -> { return Err(Alloc(error)) }
		}
		i: u64 = 0
		while i < data.len {
			self.bytes.ptr[self.bytes.len + i] = data[i]
			i += 1
		}
		self.bytes.len = needed
		return Ok(needed)
	}

	; The Vec<u8> { ptr, len, ... } prefix matches the slice fat pointer, so a
	; reinterpreting load of the head is exactly { data, len }.
	as_slice: (self: OwnedString*) -> u8[] {
		view: u8[]* = self as u8[]*
		return @view
	}

	length: (self: OwnedString*) -> u64 {
		return self.bytes.len
	}

	clear: (self: OwnedString*) {
		self.bytes.len = 0
	}

	deinit: (self: OwnedString*) {
		Vec_deinit<u8>(&self.bytes)
	}
}

; Chunked bump allocator: individual frees are impossible, reset/deinit release
; everything at once and invalidate every pointer the arena handed out.
export struct ArenaChunk {
	next: ArenaChunk*,
	base: u8*,
	size: u64,
	used: u64,
	align: u64,
}

export struct Arena {
	head: ArenaChunk*,
}

export impl Arena {
	init: (self: Arena*) {
		self.head = null
	}

	alloc: (self: Arena*, size: u64, align: u64) -> Result<u8*, AllocError> {
		if align == 0 or (align & (align - 1)) != 0 {
			return Err(InvalidAlignment)
		}
		if size == 0 {
			return Ok(align as u8*)
		}

		current: ArenaChunk* = self.head
		while current != null {
			base_address: u64 = current.base as u64
			cursor: u64 = base_address + current.used
			aligned: u64 = ((cursor + align - 1) / align) * align
			if aligned >= cursor {
				end: u64 = aligned + size
				if end >= aligned and end <= base_address + current.size {
					current.used = end - base_address
					return Ok(aligned as u8*)
				}
			}
			current = current.next
		}

		; No chunk fits: add one sized for the request (at least 4 KiB).
		chunk_bytes: u64 = 4096
		if size + align < size { return Err(AllocError.SizeOverflow) }
		if size + align > chunk_bytes { chunk_bytes = size + align }

		node: ArenaChunk* = null
		node_result := allocate(size_of<ArenaChunk>(), align_of<ArenaChunk>())
		match node_result {
			Ok(value) -> { node = value as ArenaChunk* }
			Err(error) -> { return Err(error) }
		}
		data: u8* = null
		data_result := allocate(chunk_bytes, align)
		match data_result {
			Ok(value) -> { data = value }
			Err(error) -> {
				deallocate(node as u8*, size_of<ArenaChunk>(), align_of<ArenaChunk>())
				return Err(error)
			}
		}
		@node = {
			.next  = self.head,
			.base  = data,
			.size  = chunk_bytes,
			.used  = size,
			.align = align,
		}
		self.head = node
		return Ok(data)
	}

	; Keep the chunks for reuse; every previously returned pointer is invalid.
	reset: (self: Arena*) {
		current: ArenaChunk* = self.head
		while current != null {
			current.used = 0
			current = current.next
		}
	}

	deinit: (self: Arena*) {
		current: ArenaChunk* = self.head
		while current != null {
			next: ArenaChunk* = current.next
			deallocate(current.base, current.size, current.align)
			deallocate(current as u8*, size_of<ArenaChunk>(), align_of<ArenaChunk>())
			current = next
		}
		self.head = null
	}
}

; Fixed-layout slot pool. Slots come from chunks that never move, so a T* stays
; valid until it is released or the pool is deinitialized.
export struct PoolChunk {
	next: PoolChunk*,
	base: u8*,
	states: u8*,
	capacity: u64,
}

export struct Pool<T> {
	chunks: PoolChunk*,
}

export impl Pool<T> {
	init: (self: Pool<T>*) {
		self.chunks = null
	}

	alloc: (self: Pool<T>*) -> Result<T*, AllocError> {
		stride: u64 = size_of<T>()
		if stride == 0 { stride = 1 }

		current: PoolChunk* = self.chunks
		while current != null {
			i: u64 = 0
			while i < current.capacity {
				if current.states[i] == 0 {
					current.states[i] = 1
					address: u64 = (current.base as u64) + i * stride
					return Ok(address as T*)
				}
				i += 1
			}
			current = current.next
		}

		; Every chunk is full: grow by one 64-slot chunk, failure-atomically.
		slots: u64 = 64
		bytes: u64 = 0
		sized := array_bytes(slots, stride)
		match sized {
			Ok(value) -> { bytes = value }
			Err(error) -> { return Err(error) }
		}

		node: PoolChunk* = null
		node_result := allocate(size_of<PoolChunk>(), align_of<PoolChunk>())
		match node_result {
			Ok(value) -> { node = value as PoolChunk* }
			Err(error) -> { return Err(error) }
		}
		states: u8* = null
		states_result := allocate(slots, 1)
		match states_result {
			Ok(value) -> { states = value }
			Err(error) -> {
				deallocate(node as u8*, size_of<PoolChunk>(), align_of<PoolChunk>())
				return Err(error)
			}
		}
		base: u8* = null
		base_result := allocate(bytes, align_of<T>())
		match base_result {
			Ok(value) -> { base = value }
			Err(error) -> {
				deallocate(states, slots, 1)
				deallocate(node as u8*, size_of<PoolChunk>(), align_of<PoolChunk>())
				return Err(error)
			}
		}
		i: u64 = 0
		while i < slots {
			states[i] = 0
			i += 1
		}
		@node = {
			.next     = self.chunks,
			.base     = base,
			.states   = states,
			.capacity = slots,
		}
		self.chunks = node
		states[0] = 1
		return Ok(base as T*)
	}

	; False rejects a pointer from another pool, a misaligned or interior
	; pointer, and a slot that is already free (double release).
	release: (self: Pool<T>*, ptr: T*) -> bool {
		stride: u64 = size_of<T>()
		if stride == 0 { stride = 1 }
		address: u64 = ptr as u64

		current: PoolChunk* = self.chunks
		while current != null {
			base_address: u64 = current.base as u64
			span: u64 = current.capacity * stride
			if address >= base_address and address < base_address + span {
				offset: u64 = address - base_address
				if offset % stride != 0 { return false }
				index: u64 = offset / stride
				if current.states[index] == 0 { return false }
				current.states[index] = 0
				return true
			}
			current = current.next
		}
		return false
	}

	deinit: (self: Pool<T>*) {
		stride: u64 = size_of<T>()
		if stride == 0 { stride = 1 }
		current: PoolChunk* = self.chunks
		while current != null {
			next: PoolChunk* = current.next
			deallocate(current.base, current.capacity * stride, align_of<T>())
			deallocate(current.states, current.capacity, 1)
			deallocate(current as u8*, size_of<PoolChunk>(), align_of<PoolChunk>())
			current = next
		}
		self.chunks = null
	}
}
