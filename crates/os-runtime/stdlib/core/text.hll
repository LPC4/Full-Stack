
; Shared byte/text helpers for the userspace tools (cc, as, ld, edit, shell).
; Pure pointer/byte ops, no stdlib deps, so it links into any tool's closure.

; --- Character classes ---

export is_space: (c: u8) -> bool {
	return c == ' ' or c == '\t' or c == '\r' or c == '\n'
}

export is_digit: (c: u8) -> bool {
	return c >= '0' and c <= '9'
}

export is_alpha: (c: u8) -> bool {
	if c == '_' {
		return true
	}
	if c >= 'a' and c <= 'z' {
		return true
	}
	return c >= 'A' and c <= 'Z'
}

export is_alnum: (c: u8) -> bool {
	return is_alpha(c) or is_digit(c)
}

; --- Name slots ---

export copy_name16: (dst: u8*, src: u8[]) {
	count: u64 = src.len
	if count > 15 {
		count = 15
	}
	for i in 0..count {
		@(dst + i) = src[i]
	}
	@(dst + count) = 0 as u8
}

; --- Search ---

; First 0-based index of `needle` in `hay`, or -1 (an empty needle never matches).
export find_sub: (hay: u8*, needle: u8*) -> i64 {
	if @needle == 0 {
		return -1
	}
	i: u64 = 0
	while @(hay + i) != 0 {
		j: u64 = 0
		while true {
			if @(needle + j) == 0 {
				return i as i64
			}
			if @(hay + i + j) != @(needle + j) {
				break
			}
			j = j + 1
		}
		i = i + 1
	}
	return -1
}

; --- Argument splitting ---

; Split `arg` into two NUL-terminated compatibility buffers.
export split_two: (arg: u8[], a: u8[], b: u8[]) -> bool {
	i: u64 = 0
	while i < arg.len {
		if arg[i] == ' ' {
			break
		}
		if i + 1 >= a.len {
			return false
		}
		a[i] = arg[i]
		i = i + 1
	}
	a[i] = 0 as u8
	if i == arg.len {
		return false
	}
	while i < arg.len {
		if arg[i] != ' ' {
			break
		}
		i = i + 1
	}
	if i == arg.len {
		return false
	}
	k: u64 = 0
	while i < arg.len {
		if k + 1 >= b.len {
			return false
		}
		b[k] = arg[i]
		i = i + 1
		k = k + 1
	}
	b[k] = 0 as u8
	return true
}
