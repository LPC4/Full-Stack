; Slice-based string helpers (len/equals/copy/concat) over heap-allocated u8[].

memory_allocator := import("memory_allocator")

export string_len: (text: u8[]) -> u64 {
    return text.len
}

export string_is_empty: (text: u8[]) -> bool {
    return text.len == 0
}

export string_equals: (lhs: u8[], rhs: u8[]) -> bool {
    if lhs.len != rhs.len {
        return false
    }
    for i in 0..lhs.len {
        if lhs[i] != rhs[i] {
            return false
        }
    }
    return true
}

export string_copy: (src: u8[]) -> u8[] {
    data: u8* = memory_allocator.malloc(src.len)
    for i in 0..src.len {
        data[i] = src[i]
    }
    copy: u8[] = src
    copy.ptr = data
    return copy
}

export string_concat: (left: u8[], right: u8[]) -> u8[] {
    total: u64 = left.len + right.len
    data: u8* = memory_allocator.malloc(total)
    for i in 0..left.len {
        data[i] = left[i]
    }
    for j in 0..right.len {
        data[left.len + j] = right[j]
    }
    result: u8[] = left
    result.ptr = data
    result.len = total
    return result
}

; --- String interpolation runtime (see _LANG_SPECIFICATIONS.md 5.5) ---
; The compiler lowers `string.format_into(dest, "...{x}...")` to calls into
; these helpers; they are ordinary exported functions and may be called directly.

export enum FormatError {
    FormatBufferTooSmall(u64),
    FormatSizeOverflow
}

export interface Format {
    formatted_len: (self: Self*) -> Result<u64, FormatError>
    format_exact_into: (self: Self*, destination: u8[]) -> u64
}

export fmt_result_ok: (written: u64) -> Result<u64, FormatError> {
    return Ok(written)
}

export fmt_result_too_small: (required: u64) -> Result<u64, FormatError> {
    return Err(FormatBufferTooSmall(required))
}

export fmt_result_overflow: () -> Result<u64, FormatError> {
    return Err(FormatSizeOverflow)
}

; Saturating length accumulator: all-ones marks u64 overflow and is sticky.
export fmt_len_add: (acc: u64, extra: u64) -> u64 {
    sum: u64 = acc + extra
    if sum < acc {
        return 0 - 1
    }
    return sum
}

export fmt_is_len_overflow: (acc: u64) -> bool {
    return acc == 0 - 1
}

export fmt_len_u64: (value: u64) -> u64 {
    n: u64 = 1
    v: u64 = value / 10
    while v > 0 {
        n = n + 1
        v = v / 10
    }
    return n
}

export fmt_len_i64: (value: i64) -> u64 {
    if value < 0 {
        magnitude: u64 = 0 - (value as u64)
        return 1 + fmt_len_u64(magnitude)
    }
    return fmt_len_u64(value as u64)
}

export fmt_len_bool: (value: bool) -> u64 {
    if value {
        return 4
    }
    return 5
}

export fmt_len_str: (value: u8[]) -> u64 {
    return value.len
}

export fmt_write_bytes: (dest: u8[], at: u64, data: u8[]) -> u64 {
    for i in 0..data.len {
        dest[at + i] = data[i]
    }
    return at + data.len
}

export fmt_write_u64: (dest: u8[], at: u64, value: u64) -> u64 {
    n: u64 = fmt_len_u64(value)
    v: u64 = value
    i: u64 = n
    while i > 0 {
        i = i - 1
        dest[at + i] = ((v % 10) as i32 + '0') as u8
        v = v / 10
    }
    return at + n
}

export fmt_write_i64: (dest: u8[], at: u64, value: i64) -> u64 {
    if value < 0 {
        dest[at] = '-' as u8
        magnitude: u64 = 0 - (value as u64)
        return fmt_write_u64(dest, at + 1, magnitude)
    }
    return fmt_write_u64(dest, at, value as u64)
}

export fmt_write_bool: (dest: u8[], at: u64, value: bool) -> u64 {
    if value {
        return fmt_write_bytes(dest, at, "true")
    }
    return fmt_write_bytes(dest, at, "false")
}

export fmt_subslice: (data: u8[], at: u64, len: u64) -> u8[] {
    return data[at..at + len]
}

; A Format implementation whose write length disagrees with its declared
; length is faulty; force the stable bounds trap rather than corrupt memory.
export fmt_exact_check: (expected: u64, actual: u64) {
    if actual != expected {
        empty: u8[1] = []
        bad: u8[] = empty[0..0]
        bad[0] = 1
    }
}

; --- f64 formatting: exact decimal digits via a base-1e9 bignum ---
; Deterministic and round-tripping; algorithm notes in _LANG_SPECIFICATIONS.md 5.5.

; Module-level scratch keeps fmt_f64_render's frame small (kernel frame
; ceiling); guest code is single-threaded per address space, not reentrant.
fmt_f64_limbs: u64[128] = []
fmt_f64_digit_buf: u8[800] = []

fmt_f64_bits: (value: f64) -> u64 {
    tmp: f64[1] = []
    tmp[0] = value
    words: u64* = (&tmp[0]) as u64*
    return @words
}

; Multiply limbs[0..count) by k and propagate the carry; returns the new count.
fmt_big_mul: (limbs: u64*, count: u64, k: u64) -> u64 {
    carry: u64 = 0
    n: u64 = count
    i: u64 = 0
    while i < n {
        x: u64 = limbs[i] * k + carry
        limbs[i] = x % 1000000000
        carry = x / 1000000000
        i = i + 1
    }
    while carry > 0 {
        limbs[n] = carry % 1000000000
        carry = carry / 1000000000
        n = n + 1
    }
    return n
}

; Ascii decimal digits of the bignum, most significant first; returns count.
fmt_big_digits: (limbs: u64*, count: u64, digits: u8*) -> u64 {
    top: u64 = limbs[count - 1]
    tmp: u8[9] = []
    tn: u64 = 0
    while top > 0 {
        tmp[tn] = ((top % 10) as i32 + '0') as u8
        top = top / 10
        tn = tn + 1
    }
    n: u64 = 0
    while tn > 0 {
        tn = tn - 1
        digits[n] = tmp[tn]
        n = n + 1
    }
    li: u64 = count - 1
    while li > 0 {
        li = li - 1
        limb: u64 = limbs[li]
        k: u64 = 9
        while k > 0 {
            k = k - 1
            digits[n + k] = ((limb % 10) as i32 + '0') as u8
            limb = limb / 10
        }
        n = n + 9
    }
    return n
}

; Render one f64 into out (needs >= 32 bytes); returns the byte length.
; Spelling: exact digits rounded half-even to 17 significant digits, plain
; decimal for exponents -4..16, otherwise d.ddd...eN; nan / inf / -inf / -0.
export fmt_f64_render: (value: f64, out: u8[]) -> u64 {
    bits: u64 = fmt_f64_bits(value)
    sign: u64 = bits >> 63
    exp_bits: u64 = (bits >> 52) & 2047
    frac: u64 = bits & 4503599627370495
    if exp_bits == 2047 {
        if frac != 0 {
            return fmt_write_bytes(out, 0, "nan")
        }
        if sign == 1 {
            return fmt_write_bytes(out, 0, "-inf")
        }
        return fmt_write_bytes(out, 0, "inf")
    }
    if exp_bits == 0 {
        if frac == 0 {
            if sign == 1 {
                return fmt_write_bytes(out, 0, "-0")
            }
            return fmt_write_bytes(out, 0, "0")
        }
    }
    m: u64 = frac
    e: i64 = -1074
    if exp_bits > 0 {
        m = frac | 4503599627370496
        e = (exp_bits as i64) - 1075
    }
    while (m & 1) == 0 {
        m = m >> 1
        e = e + 1
    }
    limbs: u64* = &fmt_f64_limbs[0]
    z: u64 = 0
    while z < 128 {
        limbs[z] = 0
        z = z + 1
    }
    limbs[0] = m % 1000000000
    limbs[1] = (m / 1000000000) % 1000000000
    limbs[2] = m / 1000000000000000000
    count: u64 = 3
    while count > 1 {
        if limbs[count - 1] != 0 {
            break
        }
        count = count - 1
    }
    dec_shift: i64 = 0
    if e >= 0 {
        k: i64 = 0
        while k < e {
            count = fmt_big_mul(limbs, count, 2)
            k = k + 1
        }
    } else {
        k2: i64 = e
        while k2 < 0 {
            count = fmt_big_mul(limbs, count, 5)
            k2 = k2 + 1
        }
        dec_shift = e
    }
    digits: u8* = &fmt_f64_digit_buf[0]
    ndig: u64 = fmt_big_digits(limbs, count, digits)
    dec_exp: i64 = (ndig as i64) - 1 + dec_shift
    keep: u64 = ndig
    if keep > 17 {
        keep = 17
        round_up: bool = false
        head: u8 = digits[17]
        if head > '5' as u8 {
            round_up = true
        }
        if head == '5' as u8 {
            more: bool = false
            j: u64 = 18
            while j < ndig {
                if digits[j] != '0' as u8 {
                    more = true
                    break
                }
                j = j + 1
            }
            if more {
                round_up = true
            } else {
                if ((digits[16] - '0' as u8) & 1) == 1 {
                    round_up = true
                }
            }
        }
        if round_up {
            idx: i64 = 16
            while idx >= 0 {
                if digits[idx] == '9' as u8 {
                    digits[idx] = '0' as u8
                    idx = idx - 1
                } else {
                    digits[idx] = digits[idx] + 1
                    break
                }
            }
            if idx < 0 {
                digits[0] = '1' as u8
                keep = 1
                dec_exp = dec_exp + 1
            }
        }
    }
    while keep > 1 {
        if digits[keep - 1] != '0' as u8 {
            break
        }
        keep = keep - 1
    }
    pos: u64 = 0
    if sign == 1 {
        out[0] = '-' as u8
        pos = 1
    }
    if dec_exp >= -4 {
        if dec_exp < 17 {
            if dec_exp >= 0 {
                int_digits: u64 = (dec_exp as u64) + 1
                i2: u64 = 0
                while i2 < int_digits {
                    if i2 < keep {
                        out[pos] = digits[i2]
                    } else {
                        out[pos] = '0' as u8
                    }
                    pos = pos + 1
                    i2 = i2 + 1
                }
                if keep > int_digits {
                    out[pos] = '.' as u8
                    pos = pos + 1
                    j2: u64 = int_digits
                    while j2 < keep {
                        out[pos] = digits[j2]
                        pos = pos + 1
                        j2 = j2 + 1
                    }
                }
            } else {
                out[pos] = '0' as u8
                out[pos + 1] = '.' as u8
                pos = pos + 2
                z: i64 = dec_exp + 1
                while z < 0 {
                    out[pos] = '0' as u8
                    pos = pos + 1
                    z = z + 1
                }
                j3: u64 = 0
                while j3 < keep {
                    out[pos] = digits[j3]
                    pos = pos + 1
                    j3 = j3 + 1
                }
            }
            return pos
        }
    }
    out[pos] = digits[0]
    pos = pos + 1
    if keep > 1 {
        out[pos] = '.' as u8
        pos = pos + 1
        j4: u64 = 1
        while j4 < keep {
            out[pos] = digits[j4]
            pos = pos + 1
            j4 = j4 + 1
        }
    }
    out[pos] = 'e' as u8
    pos = pos + 1
    return fmt_write_i64(out, pos, dec_exp)
}

export fmt_len_f64: (value: f64) -> u64 {
    tmp: u8[32] = []
    return fmt_f64_render(value, tmp[..])
}

export fmt_write_f64: (dest: u8[], at: u64, value: f64) -> u64 {
    tmp: u8[32] = []
    n: u64 = fmt_f64_render(value, tmp[..])
    i: u64 = 0
    while i < n {
        dest[at + i] = tmp[i]
        i = i + 1
    }
    return at + n
}
