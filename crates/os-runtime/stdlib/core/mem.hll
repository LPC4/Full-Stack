; Canonical byte-wise memory operations.

export mem_set: (dst: u8*, value: u8, n: u64) -> u8* {
	for i in 0..n {
		dst[i] = value
	}
	return dst
}

export mem_copy: (dst: u8*, src: u8*, n: u64) -> u8* {
	for i in 0..n {
		dst[i] = src[i]
	}
	return dst
}

export mem_move: (dst: u8*, src: u8*, n: u64) -> u8* {
	if n == 0 { return dst }
	if dst < src {
		return mem_copy(dst, src, n)
	}
	i: u64 = n
	while i > 0 {
		i -= 1
		dst[i] = src[i]
	}
	return dst
}

export mem_cmp: (a: u8*, b: u8*, n: u64) -> i32 {
	for i in 0..n {
		ai: u64 = a[i] as u64
		bi: u64 = b[i] as u64
		if ai < bi { return -1 }
		if ai > bi { return 1 }
	}
	return 0
}
