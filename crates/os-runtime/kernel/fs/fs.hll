; Inode-based read-write filesystem. See _OS_SPECIFICATION.md for on-disk layout.

; --- Layout constants ---

const FS_MAX_FD            = 16
const FS_NAME_LEN          = 32
const FS_MAX_INODES        = 256
const FS_BLOCK_SIZE        = 4096
const FS_INODE_SIZE        = 128
const FS_BITMAP_BLOCK      = 9
const FS_DATA_BLOCK_START  = 10
const FS_DIRENTS_PER_BLOCK = 113
const FS_DIRENT_SIZE       = 36
const FS_FD_ENTRY_SIZE     = 32
const FS_INODE_BLOCKS      = 44

struct DiskInode {
    node_type: u16,
    parent: u16,
    size: u32,
    name: u8[32],
    blocks: u16[44],
}

struct DiskDirEntry {
    name: u8[32],
    inode: u16,
    reserved: u16,
}

struct OpenFile {
    valid: u64,
    inode: u64,
    flags: u64,
    pos: u64,
}

struct PathSplit {
    parent: i64,
    name: u8[],
}

; Open flags.
const FS_OPEN_RO     = 0
const FS_OPEN_RW     = 1
const FS_OPEN_CREATE = 2

; Inode types.
const FS_TYPE_FREE = 0
const FS_TYPE_FILE = 1
const FS_TYPE_DIR  = 2

; Magic = first 4 bytes of "HLLFS\0\1\0" as little-endian u32.
const FS_MAGIC32 = 0x464C4C48

; Superblock byte offsets.
const FS_SB_BLOCK_COUNT  = 12
const FS_SB_FREE_INODES  = 16
const FS_SB_FREE_BLOCKS  = 20
const FS_SB_INODE_BITMAP = 24

; Path separator '/' and string terminator.
const FS_SLASH = '/'

; --- Externals ---

utilities := import("utilities")
mem := import("mem")
klog := import("klog")
runtime := import("runtime")

; --- Global state ---

fs_image_base:  u64 = 0
fs_image_size:  u64 = 0
fs_fd_table_pa: u64 = 0
fs_ready:       u64 = 0

; --- Typed memory access ---

export fs_rd16: (addr: u64) -> u64 {
    p: u16* = addr as u16*
    return (@p) as u64
}

export fs_rd32: (addr: u64) -> u64 {
    p: u32* = addr as u32*
    return (@p) as u64
}

export fs_wr32: (addr: u64, val: u64) {
    p: u32* = addr as u32*
    @p = val as u32
}

; --- Address helpers ---

export fs_inode_pa: (idx: u64) -> u64 {
    return fs_image_base + FS_BLOCK_SIZE + idx * FS_INODE_SIZE
}

export fs_block_pa: (blk: u64) -> u64 {
    return fs_image_base + blk * FS_BLOCK_SIZE
}

export fs_dirent_pa: (blk: u64, slot: u64) -> u64 {
    return fs_image_base + blk * FS_BLOCK_SIZE + slot * FS_DIRENT_SIZE
}

export fs_fd_pa: (fd: u64) -> u64 {
    return fs_fd_table_pa + fd * FS_FD_ENTRY_SIZE
}

fs_inode_ptr: (idx: u64) -> DiskInode* {
    return fs_inode_pa(idx) as DiskInode*
}

fs_dirent_ptr: (blk: u64, slot: u64) -> DiskDirEntry* {
    return fs_dirent_pa(blk, slot) as DiskDirEntry*
}

fs_fd_ptr: (fd: u64) -> OpenFile* {
    return fs_fd_pa(fd) as OpenFile*
}

; --- Inode field accessors ---

export fs_inode_type: (idx: u64) -> u64 {
    inode: DiskInode* = fs_inode_ptr(idx)
    return inode.node_type as u64 % 256
}

export fs_inode_size: (idx: u64) -> u64 {
    inode: DiskInode* = fs_inode_ptr(idx)
    return inode.size as u64
}

export fs_inode_set_size: (idx: u64, sz: u64) {
    inode: DiskInode* = fs_inode_ptr(idx)
    inode.size = sz as u32
}

export fs_inode_block: (idx: u64, slot: u64) -> u64 {
    inode: DiskInode* = fs_inode_ptr(idx)
    return inode.blocks[slot] as u64
}

export fs_inode_set_block: (idx: u64, slot: u64, blk: u64) {
    inode: DiskInode* = fs_inode_ptr(idx)
    inode.blocks[slot] = blk as u16
}

; --- Name-field helpers ---

fs_name_len: (name: u8*) -> u64 {
    len: u64 = 0
    while len < FS_NAME_LEN && @(name + len) != 0 {
        len = len + 1
    }
    return len
}

fs_name_eq: (stored: u8*, name: u8[]) -> i64 {
    if name.len >= FS_NAME_LEN {
        return 0
    }
    if fs_name_len(stored) != name.len {
        return 0
    }
    for i in 0..name.len {
        if @(stored + i) != name[i] {
            return 0
        }
    }
    return 1
}

fs_name_write: (dst: u8*, name: u8[]) -> i64 {
    if name.len == 0 || name.len >= FS_NAME_LEN {
        return -1 as i64
    }
    mem.memset(dst, 0, FS_NAME_LEN)
    for i in 0..name.len {
        @(dst + i) = name[i]
    }
    return 0
}

; --- Block allocation ---

; Allocate a free data block. Returns 0 if full.
export fs_alloc_block: () -> u64 {
    bitmap_base: u64 = fs_image_base + FS_BITMAP_BLOCK * FS_BLOCK_SIZE
    block_count: u64 = fs_rd16(fs_image_base + FS_SB_BLOCK_COUNT)
    bit: u64 = 0
    while bit < block_count {
        byte_off: u64 = bit / 8
        bit_off:  u64 = bit % 8
        p: u8* = (bitmap_base + byte_off) as u8*
        b: u8 = @p
        mask: u64 = 1 << bit_off
        if (b as u64 & mask) != 0 {
            @p = (b as u64 & (255 ^ mask)) as u8
            free: u64 = fs_rd32(fs_image_base + FS_SB_FREE_BLOCKS)
            if free > 0 {
                fs_wr32(fs_image_base + FS_SB_FREE_BLOCKS, free - 1)
            }
            return FS_DATA_BLOCK_START + bit
        }
        bit = bit + 1
    }
    return 0
}

; Return block blk to the free-block bitmap.
export fs_free_block: (blk: u64) {
    if blk < FS_DATA_BLOCK_START {
        return
    }
    bit: u64 = blk - FS_DATA_BLOCK_START
    bitmap_base: u64 = fs_image_base + FS_BITMAP_BLOCK * FS_BLOCK_SIZE
    p: u8* = (bitmap_base + bit / 8) as u8*
    b: u8 = @p
    @p = (b as u64 | (1 << (bit % 8))) as u8
    free: u64 = fs_rd32(fs_image_base + FS_SB_FREE_BLOCKS)
    fs_wr32(fs_image_base + FS_SB_FREE_BLOCKS, free + 1)
}

; --- Inode allocation ---

; Allocate a free inode. Returns index, or -1 on failure.
export fs_alloc_inode: () -> i64 {
    bitmap_base: u64 = fs_image_base + FS_SB_INODE_BITMAP
    byte: u64 = 0
    while byte < 32 {
        p: u8* = (bitmap_base + byte) as u8*
        b: u8 = @p
        if b != 0 {
            bit: u64 = 0
            while bit < 8 {
                mask: u64 = 1 << bit
                if (b as u64 & mask) != 0 {
                    @p = (b as u64 & (255 ^ mask)) as u8
                    free: u64 = fs_rd32(fs_image_base + FS_SB_FREE_INODES)
                    if free > 0 {
                        fs_wr32(fs_image_base + FS_SB_FREE_INODES, free - 1)
                    }
                    return (byte * 8 + bit) as i64
                }
                bit = bit + 1
            }
        }
        byte = byte + 1
    }
    return -1 as i64
}

; Return inode idx to the free-inode bitmap and mark it free.
export fs_free_inode: (idx: u64) {
    bitmap_base: u64 = fs_image_base + FS_SB_INODE_BITMAP
    p: u8* = (bitmap_base + idx / 8) as u8*
    b: u8 = @p
    @p = (b as u64 | (1 << (idx % 8))) as u8
    free: u64 = fs_rd32(fs_image_base + FS_SB_FREE_INODES)
    fs_wr32(fs_image_base + FS_SB_FREE_INODES, free + 1)
    inode: DiskInode* = fs_inode_ptr(idx)
    inode.node_type = FS_TYPE_FREE as u16
}

; --- Directory operations ---

; Find entry `name` in directory dir_inode. Returns child inode, or -1.
export fs_find_in_dir: (dir_inode: u64, name: u8[]) -> i64 {
    if fs_inode_type(dir_inode) != FS_TYPE_DIR {
        return -1 as i64
    }
    for blk_slot in 0..FS_INODE_BLOCKS {
        blk: u64 = fs_inode_block(dir_inode, blk_slot)
        if blk == 0 {
            break
        }
        for slot in 0..FS_DIRENTS_PER_BLOCK {
            de: DiskDirEntry* = fs_dirent_ptr(blk, slot)
            np: u8* = &de.name[0]
            if @np != 0 {
                if fs_name_eq(np, name) == 1 {
                    return de.inode as i64
                }
            }
        }
    }
    return -1 as i64
}

; Add a (child_name, child_inode) entry to directory dir_inode.
; Returns 0 on success, -1 on failure.
export fs_add_dirent: (dir_inode: u64, child_name: u8[], child_inode: u64) -> i64 {
    if child_name.len == 0 || child_name.len >= FS_NAME_LEN {
        return -1 as i64
    }
    for blk_slot in 0..FS_INODE_BLOCKS {
        blk: u64 = fs_inode_block(dir_inode, blk_slot)
        if blk == 0 {
            new_blk: u64 = fs_alloc_block()
            if new_blk == 0 {
                return -1 as i64
            }
            mem.memset(fs_block_pa(new_blk) as u8*, 0, FS_BLOCK_SIZE)
            fs_inode_set_block(dir_inode, blk_slot, new_blk)
            blk = new_blk
        }
        for slot in 0..FS_DIRENTS_PER_BLOCK {
            de: DiskDirEntry* = fs_dirent_ptr(blk, slot)
            np: u8* = &de.name[0]
            if @np == 0 {
                if fs_name_write(np, child_name) < 0 {
                    return -1 as i64
                }
                de.inode = child_inode as u16
                de.reserved = 0 as u16
                fs_inode_set_size(dir_inode, fs_inode_size(dir_inode) + 1)
                return 0
            }
        }
    }
    return -1 as i64
}

; Remove entry `name` from directory dir_inode.
; Returns 0 on success, -1 if not found.
export fs_remove_dirent: (dir_inode: u64, name: u8[]) -> i64 {
    for blk_slot in 0..FS_INODE_BLOCKS {
        blk: u64 = fs_inode_block(dir_inode, blk_slot)
        if blk == 0 {
            break
        }
        for slot in 0..FS_DIRENTS_PER_BLOCK {
            de: DiskDirEntry* = fs_dirent_ptr(blk, slot)
            np: u8* = &de.name[0]
            if @np != 0 {
                if fs_name_eq(np, name) == 1 {
                    @np = 0 as u8
                    sz: u64 = fs_inode_size(dir_inode)
                    if sz > 0 {
                        fs_inode_set_size(dir_inode, sz - 1)
                    }
                    return 0
                }
            }
        }
    }
    return -1 as i64
}

; --- Path resolution ---

; Resolve an absolute path to an inode index. Returns -1 on error.
; Root "/" is inode 0.
export fs_resolve: (path: u8[]) -> i64 {
    if path.len == 0 {
        return -1 as i64
    }
    if path[0] != FS_SLASH {
        return -1 as i64
    }
    cur: i64 = 0
    pos: u64 = 1
    while pos < path.len {
        while pos < path.len {
            if path[pos] != FS_SLASH {
                break
            }
            pos = pos + 1
        }
        if pos >= path.len {
            return cur
        }
        start: u64 = pos
        while pos < path.len {
            if path[pos] == FS_SLASH {
                break
            }
            if path[pos] == 0 {
                return -1 as i64
            }
            pos = pos + 1
        }
        if pos - start >= FS_NAME_LEN {
            return -1 as i64
        }
        component: u8[] = path[start..pos]
        found: i64 = fs_find_in_dir(cur as u64, component)
        if found < 0 {
            return -1 as i64
        }
        cur = found
    }
    return cur
}

export fs_split_path: (path: u8[]) -> PathSplit {
    if path.len < 2 {
        return PathSplit { .parent = -1 as i64, .name = "" }
    }
    if path[0] != FS_SLASH {
        return PathSplit { .parent = -1 as i64, .name = "" }
    }
    i: u64 = path.len
    while i > 0 {
        i = i - 1
        if path[i] == FS_SLASH {
            name_start: u64 = i + 1
            name_len: u64 = path.len - name_start
            if name_len == 0 || name_len >= FS_NAME_LEN {
                return PathSplit { .parent = -1 as i64, .name = "" }
            }
            name: u8[] = path[name_start..path.len]
            if i == 0 {
                return PathSplit { .parent = 0, .name = name }
            }
            parent_path: u8[] = path[0..i]
            return PathSplit { .parent = fs_resolve(parent_path), .name = name }
        }
    }
    return PathSplit { .parent = -1 as i64, .name = "" }
}

; Allocate a new inode of node_type under parent_inode with the given name.
; Returns the new inode index, or -1 on error.
export fs_create_at: (parent_inode: u64, name: u8[], node_type: u64) -> i64 {
    if fs_inode_type(parent_inode) != FS_TYPE_DIR {
        return -1 as i64
    }
    new_idx: i64 = fs_alloc_inode()
    if new_idx < 0 {
        return -1 as i64
    }
    inode: DiskInode* = fs_inode_ptr(new_idx as u64)
    inode.node_type = node_type as u16
    inode.parent = parent_inode as u16
    inode.size = 0 as u32
    if fs_name_write(&inode.name[0], name) < 0 {
        fs_free_inode(new_idx as u64)
        return -1 as i64
    }
    for slot in 0..FS_INODE_BLOCKS {
        inode.blocks[slot] = 0 as u16
    }
    if fs_add_dirent(parent_inode, name, new_idx as u64) < 0 {
        fs_free_inode(new_idx as u64)
        return -1 as i64
    }
    return new_idx
}

; --- Public API ---

; Mount the filesystem image at base_pa. Validates the magic number, allocates
; the kernel fd table, and logs the inode census.
export fs_init: (base_pa: u64, image_size: u64) {
    if size_of<DiskInode>() != FS_INODE_SIZE or
       size_of<DiskDirEntry>() != FS_DIRENT_SIZE or
       size_of<OpenFile>() != FS_FD_ENTRY_SIZE {
        runtime.panic("filesystem layout mismatch".ptr)
    }
    if fs_rd32(base_pa) != FS_MAGIC32 {
        klog.warn("[  FS  ] bad magic, not mounting".ptr)
        return
    }
    fs_image_base = base_pa
    fs_image_size = image_size

    fd_table: u8* = utilities.malloc(FS_MAX_FD * size_of<OpenFile>())
    fs_fd_table_pa = fd_table as u64
    mem.memset(fd_table, 0, FS_MAX_FD * size_of<OpenFile>())
    fs_ready = 1

    files: i64 = 0
    dirs:  i64 = 0
    idx: u64 = 0
    while idx < FS_MAX_INODES {
        t: u64 = fs_inode_type(idx)
        if t == FS_TYPE_FILE {
            files = files + 1
        }
        if t == FS_TYPE_DIR {
            dirs = dirs + 1
        }
        idx = idx + 1
    }
    klog.int("[  FS  ] mounted, files".ptr, files)
    klog.int("[  FS  ] dirs".ptr, dirs)
}

; Open a file by absolute path. flags: 0=RO, 1=RW, 2=create (implies RW).
; Returns fd >= 2 on success, or -1 on error.
export fs_open: (path: u8[], flags: u64) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    inode: i64 = fs_resolve(path)
    if flags == FS_OPEN_CREATE {
        if inode < 0 {
            split: PathSplit = fs_split_path(path)
            if split.parent < 0 {
                return -1 as i64
            }
            inode = fs_create_at(split.parent as u64, split.name, FS_TYPE_FILE)
            if inode < 0 {
                return -1 as i64
            }
        }
    } else {
        if inode < 0 {
            return -1 as i64
        }
    }
    fd: u64 = 2
    while fd < FS_MAX_FD {
        slot: OpenFile* = fs_fd_ptr(fd)
        if slot.valid == 0 {
            slot.valid = 1
            slot.inode = inode as u64
            if flags == FS_OPEN_RO {
                slot.flags = FS_OPEN_RO
            } else {
                slot.flags = FS_OPEN_RW
            }
            slot.pos = 0
            return fd as i64
        }
        fd = fd + 1
    }
    return -1 as i64
}

; Read up to len bytes from fd at the given byte offset into buf.
; Returns bytes read, or -1 on error.
export fs_read: (fd: i64, buf: u8*, offset: u64, len: u64) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    if fd < 2 {
        return -1 as i64
    }
    if len == 0 {
        return 0
    }
    slot: OpenFile* = fs_fd_ptr(fd as u64)
    if slot.valid == 0 {
        return -1 as i64
    }
    inode: u64 = slot.inode
    size: u64 = fs_inode_size(inode)
    if offset >= size {
        return -1 as i64
    }
    to_read: u64 = len
    if to_read > size - offset {
        to_read = size - offset
    }
    done: u64 = 0
    while done < to_read {
        file_off: u64 = offset + done
        blk_slot: u64 = file_off / FS_BLOCK_SIZE
        blk_off:  u64 = file_off % FS_BLOCK_SIZE
        if blk_slot >= FS_INODE_BLOCKS {
            break
        }
        blk: u64 = fs_inode_block(inode, blk_slot)
        if blk == 0 {
            break
        }
        chunk: u64 = to_read - done
        if chunk > FS_BLOCK_SIZE - blk_off {
            chunk = FS_BLOCK_SIZE - blk_off
        }
        mem.memcpy(buf + done, (fs_block_pa(blk) + blk_off) as u8*, chunk)
        done = done + chunk
    }
    return done as i64
}

; Write len bytes from buf to fd at the given byte offset, extending the file
; and allocating blocks as needed. Returns bytes written, or -1 on error.
export fs_write: (fd: i64, buf: u8*, offset: u64, len: u64) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    if fd < 2 {
        return -1 as i64
    }
    if len == 0 {
        return 0
    }
    slot: OpenFile* = fs_fd_ptr(fd as u64)
    if slot.valid == 0 {
        return -1 as i64
    }
    if slot.flags == FS_OPEN_RO {
        return -1 as i64
    }
    inode: u64 = slot.inode
    done: u64 = 0
    while done < len {
        file_off: u64 = offset + done
        blk_slot: u64 = file_off / FS_BLOCK_SIZE
        blk_off:  u64 = file_off % FS_BLOCK_SIZE
        if blk_slot >= FS_INODE_BLOCKS {
            break
        }
        blk: u64 = fs_inode_block(inode, blk_slot)
        if blk == 0 {
            new_blk: u64 = fs_alloc_block()
            if new_blk == 0 {
                break
            }
            mem.memset(fs_block_pa(new_blk) as u8*, 0, FS_BLOCK_SIZE)
            fs_inode_set_block(inode, blk_slot, new_blk)
            blk = new_blk
        }
        chunk: u64 = len - done
        if chunk > FS_BLOCK_SIZE - blk_off {
            chunk = FS_BLOCK_SIZE - blk_off
        }
        mem.memcpy((fs_block_pa(blk) + blk_off) as u8*, buf + done, chunk)
        done = done + chunk
    }
    end: u64 = offset + done
    if end > fs_inode_size(inode) {
        fs_inode_set_size(inode, end)
    }
    return done as i64
}

; Shrink the file behind fd to exactly `len` bytes: set the inode size and free
; data blocks past `len`. Returns 0 on success, -1 on error. Does not grow files.
export fs_truncate: (fd: i64, len: u64) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    if fd < 2 {
        return -1 as i64
    }
    slot: OpenFile* = fs_fd_ptr(fd as u64)
    if slot.valid == 0 {
        return -1 as i64
    }
    if slot.flags == FS_OPEN_RO {
        return -1 as i64
    }
    inode: u64 = slot.inode
    if len >= fs_inode_size(inode) {
        return 0
    }
    ; Number of blocks the truncated file still needs; free the rest.
    keep: u64 = (len + FS_BLOCK_SIZE - 1) / FS_BLOCK_SIZE
    for blk_slot in keep..FS_INODE_BLOCKS {
        blk: u64 = fs_inode_block(inode, blk_slot)
        if blk != 0 {
            fs_free_block(blk)
            fs_inode_set_block(inode, blk_slot, 0)
        }
    }
    fs_inode_set_size(inode, len)
    return 0
}

; Return the size in bytes of the file behind fd, or 0 if fd is invalid.
; Used to seek to end for append-mode (`>>`) redirection.
export fs_fd_size: (fd: i64) -> u64 {
    if fd < 2 {
        return 0
    }
    slot: OpenFile* = fs_fd_ptr(fd as u64)
    if slot.valid == 0 {
        return 0
    }
    return fs_inode_size(slot.inode)
}

; Return the implicit sequential position for fd, or 0 if fd is invalid.
export fs_get_pos: (fd: i64) -> u64 {
    if fd < 2 {
        return 0
    }
    slot: OpenFile* = fs_fd_ptr(fd as u64)
    return slot.pos
}

; Set the implicit sequential position for fd.
export fs_set_pos: (fd: i64, pos: u64) {
    if fd < 2 {
        return
    }
    slot: OpenFile* = fs_fd_ptr(fd as u64)
    slot.pos = pos
}

; Release a file descriptor slot.
export fs_close: (fd: i64) {
    if fs_ready == 0 {
        return
    }
    if fd < 2 {
        return
    }
    slot: OpenFile* = fs_fd_ptr(fd as u64)
    slot.valid = 0
    slot.inode = 0
    slot.flags = 0
    slot.pos = 0
}

; Create a file (type=1) or directory (type=2) under parent_path.
export fs_create: (parent_path: u8[], name: u8[], node_type: u8) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    parent: i64 = fs_resolve(parent_path)
    if parent < 0 {
        return -1 as i64
    }
    return fs_create_at(parent as u64, name, node_type as u64)
}

; Return the inode type at an absolute path (1=file, 2=dir), or -1 if missing.
export fs_stat: (path: u8[]) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    inode: i64 = fs_resolve(path)
    if inode < 0 {
        return -1 as i64
    }
    return fs_inode_type(inode as u64) as i64
}

; Result packs the name length above the low-byte inode type.
export fs_readdir: (path: u8[], index: u64, name_buf: u8[]) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    dir_inode: i64 = fs_resolve(path)
    if dir_inode < 0 {
        return -1 as i64
    }
    if fs_inode_type(dir_inode as u64) != FS_TYPE_DIR {
        return -1 as i64
    }
    count: u64 = 0
    for blk_slot in 0..FS_INODE_BLOCKS {
        blk: u64 = fs_inode_block(dir_inode as u64, blk_slot)
        if blk == 0 {
            break
        }
        for slot in 0..FS_DIRENTS_PER_BLOCK {
            de: DiskDirEntry* = fs_dirent_ptr(blk, slot)
            np: u8* = &de.name[0]
            if @np != 0 {
                if count == index {
                    name_len: u64 = fs_name_len(np)
                    if name_len > name_buf.len {
                        return -1 as i64
                    }
                    for i in 0..name_len {
                        name_buf[i] = @(np + i)
                    }
                    child: u64 = de.inode as u64
                    return ((name_len << 8) | fs_inode_type(child)) as i64
                }
                count = count + 1
            }
        }
    }
    return -1 as i64
}

; Create a directory at the given absolute path.
; Returns the new inode index, or -1 on error.
export fs_mkdir: (path: u8[]) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    split: PathSplit = fs_split_path(path)
    if split.parent < 0 {
        return -1 as i64
    }
    return fs_create_at(split.parent as u64, split.name, FS_TYPE_DIR)
}

; Free all data blocks and return inode to the free pool. Does not touch directory entries.
export fs_release_inode: (inode: u64) {
    blk_slot: u64 = 0
    while blk_slot < FS_INODE_BLOCKS {
        blk: u64 = fs_inode_block(inode, blk_slot)
        if blk != 0 {
            fs_free_block(blk)
            fs_inode_set_block(inode, blk_slot, 0)
        }
        blk_slot = blk_slot + 1
    }
    fs_free_inode(inode)
}

; Remove a regular file: detach from parent, free data blocks and inode.
; Refuses directories (use fs_rmdir). 0 on success, -1 on error.
export fs_unlink: (path: u8[]) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    inode: i64 = fs_resolve(path)
    if inode < 0 {
        return -1 as i64
    }
    if fs_inode_type(inode as u64) != FS_TYPE_FILE {
        return -1 as i64
    }
    split: PathSplit = fs_split_path(path)
    if split.parent < 0 {
        return -1 as i64
    }
    if fs_remove_dirent(split.parent as u64, split.name) < 0 {
        return -1 as i64
    }
    fs_release_inode(inode as u64)
    return 0
}

; Remove an empty directory at an absolute path. Refuses the root, non-empty
; directories, and non-directories. Returns 0 on success, -1 on error.
export fs_rmdir: (path: u8[]) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    inode: i64 = fs_resolve(path)
    ; inode 0 is the root; a negative result is an error. Neither is removable.
    if inode <= 0 {
        return -1 as i64
    }
    if fs_inode_type(inode as u64) != FS_TYPE_DIR {
        return -1 as i64
    }
    ; A directory's size field tracks its live dirent count, so 0 means empty.
    if fs_inode_size(inode as u64) != 0 {
        return -1 as i64
    }
    split: PathSplit = fs_split_path(path)
    if split.parent < 0 {
        return -1 as i64
    }
    if fs_remove_dirent(split.parent as u64, split.name) < 0 {
        return -1 as i64
    }
    fs_release_inode(inode as u64)
    return 0
}

; Move a file or directory from old_path to new_path (cross-directory allowed).
; Returns 0 on success, -1 on error.
export fs_rename: (old_path: u8[], new_path: u8[]) -> i64 {
    if fs_ready == 0 {
        return -1 as i64
    }
    inode: i64 = fs_resolve(old_path)
    if inode < 0 {
        return -1 as i64
    }
    old_split: PathSplit = fs_split_path(old_path)
    if old_split.parent < 0 {
        return -1 as i64
    }
    new_split: PathSplit = fs_split_path(new_path)
    if new_split.parent < 0 {
        return -1 as i64
    }
    if fs_remove_dirent(old_split.parent as u64, old_split.name) < 0 {
        return -1 as i64
    }
    if fs_add_dirent(new_split.parent as u64, new_split.name, inode as u64) < 0 {
        ; Roll back: re-add to the original parent.
        fs_add_dirent(old_split.parent as u64, old_split.name, inode as u64)
        return -1 as i64
    }
    moved: DiskInode* = fs_inode_ptr(inode as u64)
    fs_name_write(&moved.name[0], new_split.name)
    moved.parent = new_split.parent as u16
    return 0
}
