; Filesystem records and unchanged disk-layout constants.

; --- Public API ---

export const FS_MAX_FD = 16
export const FS_NAME_LEN = 32
export const FS_MAX_INODES = 256
export const FS_BLOCK_SIZE = 4096
export const FS_INODE_SIZE = 128
export const FS_BITMAP_BLOCK = 9
export const FS_DATA_BLOCK_START = 10
export const FS_DIRENTS_PER_BLOCK = 113
export const FS_DIRENT_SIZE = 36
export const FS_FD_ENTRY_SIZE = 32
export const FS_INODE_BLOCKS = 44

export const FS_OPEN_RO = 0
export const FS_OPEN_RW = 1
export const FS_OPEN_CREATE = 2

export const FS_TYPE_FREE = 0
export const FS_TYPE_FILE = 1
export const FS_TYPE_DIR = 2

export const FS_MAGIC32 = 0x464C4C48
export const FS_SB_BLOCK_COUNT = 12
export const FS_SB_FREE_INODES = 16
export const FS_SB_FREE_BLOCKS = 20
export const FS_SB_INODE_BITMAP = 24
export const FS_SLASH = '/'

export struct DiskInode {
    node_type: u16,
    parent: u16,
    size: u32,
    name: u8[32],
    blocks: u16[44],
}

export struct DiskDirEntry {
    name: u8[32],
    inode: u16,
    reserved: u16,
}

export struct OpenFile {
    valid: u64,
    inode: u64,
    flags: u64,
    pos: u64,
}

export enum FsError {
    InvalidPath
    NotFound
    NoSpace
    InvalidDescriptor
}

export struct PathSplit {
    parent: i64,
    name: u8[],
}

export struct FileSystemState {
    image_base: u64,
    image_size: u64,
    fd_table_pa: u64,
    ready: u64,
}
