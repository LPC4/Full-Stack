; Sv39 page-table construction and validation.

config := import("kernel/core/kernel_config.hll")
mem := import("mem")
pages := import("kernel/mm/physical_pages.hll")
runtime := import("runtime")

; --- State ---

const PAGE_SIZE = 4096
const TABLE_ENTRIES = 512

; --- Public API ---

export page_tables_alloc_root: () -> u64 {
    return alloc_table() as u64
}

export page_tables_map: (root: u64, virtual: u64, physical: u64, flags: u64) {
    assert_canonical(virtual)
    level2: u64* = root as u64*
    level1: u64* = walk_or_alloc(level2, (virtual >> 30) & 0x1FF)
    level0: u64* = walk_or_alloc(level1, (virtual >> 21) & 0x1FF)
    index: u64 = (virtual >> 12) & 0x1FF
    level0[index] = ((physical >> 12) << 10) + flags + config.PTE_VALID
}

export page_tables_map_superpage: (root: u64, virtual: u64, physical: u64, flags: u64) {
    assert_canonical(virtual)
    level2: u64* = root as u64*
    index: u64 = (virtual >> 30) & 0x1FF
    level2[index] = ((physical >> 12) << 10) + flags + config.PTE_VALID
}

export page_tables_validate_user: (root: u64, address: u64, len: u64, write: i64) -> i64 {
    if len == 0 {
        return 1
    }
    end: u64 = address + len
    if root == 0 or address == 0 or end <= address or
       (address >> 39) != 0 or ((end - 1) >> 39) != 0 {
        return 0
    }

    page: u64 = (address / PAGE_SIZE) * PAGE_SIZE
    while page < end {
        level2: u64* = root as u64*
        entry2: u64 = level2[(page >> 30) & 0x1FF]
        if !is_branch(entry2) {
            return 0
        }
        level1: u64* = pte_address(entry2)
        entry1: u64 = level1[(page >> 21) & 0x1FF]
        if !is_branch(entry1) {
            return 0
        }
        level0: u64* = pte_address(entry1)
        leaf: u64 = level0[(page >> 12) & 0x1FF]
        required: u64 = (config.PTE_VALID + config.PTE_USER + config.PTE_READ) as u64
        if (leaf & required) != required {
            return 0
        }
        if write != 0 and (leaf & config.PTE_WRITE) == 0 {
            return 0
        }
        page = page + PAGE_SIZE
    }
    return 1
}

; --- Implementation ---

alloc_table: () -> u64* {
    page: u8* = pages.alloc()
    if page == null {
        runtime.panic("page-table allocation failed".ptr)
    }
    mem.set(page, 0, PAGE_SIZE)
    return page as u64*
}

walk_or_alloc: (table: u64*, index: u64) -> u64* {
    entry: u64 = table[index]
    if (entry & config.PTE_VALID) != 0 {
        return pte_address(entry)
    }
    next: u64* = alloc_table()
    table[index] = (((next as u64) >> 12) << 10) + config.PTE_VALID
    return next
}

is_branch: (entry: u64) -> bool {
    return (entry & config.PTE_VALID) != 0 and
        (entry & (config.PTE_READ + config.PTE_WRITE + config.PTE_EXECUTE)) == 0
}

pte_address: (entry: u64) -> u64* {
    return ((entry >> 10) << 12) as u64*
}

assert_canonical: (address: u64) {
    upper: u64 = address >> 39
    if ((address >> 38) & 1) == 0 {
        if upper != 0 {
            runtime.panic("non-canonical virtual address".ptr)
        }
    } else {
        if upper != 0x1FFFFFF {
            runtime.panic("non-canonical virtual address".ptr)
        }
    }
}
