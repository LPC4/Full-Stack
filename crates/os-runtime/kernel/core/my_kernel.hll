; Kernel initialization and boot orchestration.

layout       := import("kernel/core/kernel_abi.hll")
config       := import("kernel/core/kernel_config.hll")
heap_backend := import("heap_backend")
heap         := import("kernel/mm/kernel_heap.hll")
klog         := import("klog")
system       := import("kernel/arch/riscv64/system.hll")
timer        := import("kernel/arch/riscv64/timer.hll")
plic         := import("kernel/arch/riscv64/interrupt_controller.hll")
csr          := import("kernel/arch/riscv64/csr.hll")
mem          := import("mem")
trap_entry   := import("kernel/trap/trap_entry.hll")
pages        := import("kernel/mm/physical_pages.hll")
address_space := import("kernel/mm/address_space.hll")
checks       := import("kernel/core/checks.hll")
tasks        := import("kernel/sched/tasks.hll")
files        := import("kernel/fs/files.hll")

; --- State ---
const USER_BINARY_PA = 0x87F00000
const USER_META_PA   = 0x87EFF000
const USER_CODE_VA   = 0x40000000

struct InjectedUserImage {
    entry: u64,
    size: u64,
}

struct InjectedFileSystem {
    base: u64,
    size: u64,
}

; --- Public API ---
kmain: () {
    boot_console()
    boot_traps()
    boot_timer()
    boot_device_discovery()
    boot_plic()
    boot_memory_diagnostics()
    boot_heap()
    boot_physical_pages()
    boot_address_space()
    boot_tasks()
    boot_user_process()
    boot_final()
    boot_filesystem()
    boot_interrupts()
    boot_idle()
}

; --- Implementation ---

boot_console: () {
    klog.ok("kernel starting".ptr)
    klog.ok("console online".ptr)
}

boot_traps: () {
    trap_entry.trap_init()
    klog.ok("trap handler installed".ptr)
    klog.ok("syscall handler online".ptr)
}

boot_timer: () {
    timer.rearm(1000000)
    klog.ok("timer armed".ptr)
}

boot_device_discovery: () {
    ; Devices are hard-coded from the memory map; no device tree is parsed.
    klog.warn("device tree: not implemented".ptr)
}

boot_plic: () {
    plic.init()
    klog.ok("interrupt controller online".ptr)
}

boot_memory_diagnostics: () {
    klog.ok("running memory diagnostics...".ptr)
    test_result: i64 = checks.memory_self_test(256)
    if test_result == 0 {
        klog.error("halt: memory test failed".ptr)
        system.shutdown(1)
    }
}

boot_heap: () {
    ; Before this handoff, only the 64 KiB bootstrap buffer backs allocations.
    heap_backend.heap_set_region(config.KHEAP_BASE, config.KHEAP_END)
    probe: u8* = heap.alloc_bytes(64)
    mem.set(probe, 0, 64)
    klog.ok("heap ready".ptr)
}

boot_physical_pages: () {
    pages.boot()
    checks.pmm_ops_test()
}

boot_address_space: () {
    address_space.boot()
}

boot_tasks: () {
    tasks.init()
}

boot_user_process: () {
    if !spawn_user_process() {
        system.shutdown(0)
    }
}

boot_interrupts: () {
    ; The first timer tick requires a runnable process in the scheduler queue.
    csr.enable_interrupts()
}

boot_idle: () {
    klog.ok("entering scheduler idle loop".ptr)
    while 1 == 1 {
        asm { wfi }
    }
}

boot_final: () {
    klog.int("hart id".ptr, 0)
    klog.int("ram MB".ptr, 128)
    klog.ok("boot complete".ptr)
}

boot_filesystem: () {
    image: InjectedFileSystem* = 0x87BFF000 as InjectedFileSystem*
    if image.base != 0 {
        files.init(image.base, image.size)
    }
}

spawn_user_process: () -> bool {
    ; A zero first word is the boot protocol's absent-image sentinel.
    header_ptr: u64* = USER_BINARY_PA as u64*
    if header_ptr[0] == 0 {
        klog.warn("no user binary present".ptr)
        return false
    }

    klog.ok("spawning user process".ptr)

    src_user_pa: u64 = USER_BINARY_PA as u64

    image: InjectedUserImage* = USER_META_PA as InjectedUserImage*

    if image.entry == 0 {
        klog.warn("user entry is 0, skipping".ptr)
        return false
    }

    if image.size == 0 {
        klog.warn("user size is 0, skipping".ptr)
        return false
    }

    page_size: u64 = 4096
    page_count: u64 = (image.size + page_size - 1) / page_size

    klog.int("[ PROC ] user_size bytes".ptr, image.size as i64)
    klog.int("[ PROC ] pages to map".ptr, page_count as i64)

    pcb: layout.Pcb* = tasks.build(image.entry)

    for i in 0..page_count {
        dst_page: u8* = pages.alloc()
        if dst_page == null {
            klog.error("[ PROC ] halt: user page alloc failed".ptr)
            system.shutdown(1)
        }

        offset: u64 = i * page_size
        src_page_pa: u64 = src_user_pa + offset

        ; Identity-mapped: physical address == virtual address.
        mem.copy(dst_page, src_page_pa as u8*, page_size)

        user_va: u64 = USER_CODE_VA + offset
        address_space.map(
            pcb.page_root,
            user_va,
            dst_page as u64,
            config.PTE_READ + config.PTE_WRITE + config.PTE_EXECUTE + config.PTE_USER,
        )
    }

    klog.int("[ PROC ] mapped pages at 0x40000000, count".ptr, page_count as i64)

    tasks.enqueue(pcb)

    klog.int("[ PROC ] pid 1 ready, entry".ptr, image.entry as i64)
    return true
}
