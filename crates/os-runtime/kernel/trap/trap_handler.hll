; Central trap dispatch: interrupts (timer/external) and U-mode ecalls. See OS spec ch.5/6.

layout    := import("kernel/core/kernel_abi.hll")
runtime   := import("runtime")
klog      := import("klog")
timer     := import("kernel/arch/riscv64/timer.hll")
plic      := import("kernel/arch/riscv64/interrupt_controller.hll")
csr       := import("kernel/arch/riscv64/csr.hll")
uart      := import("kernel/arch/riscv64/uart.hll")
syscalls  := import("kernel/syscall/syscalls.hll")
tasks     := import("kernel/sched/tasks.hll")

; --- State ---

kernel_tick: u64 = 0

; --- Public API ---

export trap_handler: (frame: layout.TrapFrame*) {
    csr.allow_user_memory()
    cause: u64 = frame.scause
    signed_cause: i64 = cause as i64
    if signed_cause < 0 {
        match cause % 16 {
            5 -> { timer_interrupt(frame) }
            9 -> { external_interrupt(frame) }
            1 -> { csr.clear_software_interrupt() }
            _ -> {
                klog.hex("unhandled interrupt scause".ptr, cause)
                runtime.panic("unhandled interrupt".ptr)
            }
        }
        return
    }
    if cause == 8 {
        ecall(frame)
        return
    }
    fatal_exception(frame)
}

; --- Implementation ---

timer_interrupt: (frame: layout.TrapFrame*) {
    kernel_tick = kernel_tick + 1
    timer.rearm(1000000)
    tasks.schedule(frame, Schedule)
}

external_interrupt: (frame: layout.TrapFrame*) {
    plic.claim_and_complete()
    uart.mask_receive()
    if tasks.wake_input() == 1 {
        tasks.schedule(frame, Schedule)
    }
}

ecall: (frame: layout.TrapFrame*) {
    action: layout.SysAction = syscalls.dispatch(frame)
    frame.sepc = frame.sepc + 4
    match action {
        Continue -> {}
        _ -> { tasks.schedule(frame, action) }
    }
}

fatal_exception: (frame: layout.TrapFrame*) {
    klog.hex("exception scause".ptr, frame.scause)
    klog.hex("exception sepc".ptr, frame.sepc)
    klog.hex("exception stval".ptr, frame.stval)
    runtime.panic("unhandled exception".ptr)
}
