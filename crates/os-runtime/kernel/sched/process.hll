; Process control block lifecycle. PCB layout, process states, trap-frame slots,
; and VMM page-flag bits come from layout.hll; full PCB map in OS spec 5.2.

layout      := import("layout")
utilities   := import("utilities")
mem         := import("mem")
pmm         := import("pmm")
vmm         := import("vmm")
runtime     := import("runtime")
klog        := import("klog")

; Canonical user-stack top, shared by all processes (isolation is per-root, not
; by VA slotting). See OS spec ch.4.3.
const USER_STACK_BASE = 0x80000000

next_pid: u64 = 1

export process_init: () {
    if size_of<layout.Pcb>() != PCB_SIZE or size_of<layout.TrapFrame>() != TF_BYTES {
        runtime.panic("kernel layout mismatch".ptr)
    }
    klog.ok("process subsystem ready".ptr)
}

; Return the pid that the next process_create call will assign.
; sys_exec reads this to place a program's code at a matching per-pid VA slot.
export process_peek_pid: () -> u64 {
    return next_pid
}

; Create a new user process whose stack lives at the given top VA.
; Returns a typed PCB pointer, the caller passes it to scheduler.add().
export process_create_at: (entry_pc: u64, stack_top: u64) -> layout.Pcb* {
    pcb: layout.Pcb* = utilities.malloc(size_of<layout.Pcb>()) as layout.Pcb*
    mem.set(pcb as u8*, 0, size_of<layout.Pcb>())

    pcb.pid = next_pid
    next_pid = next_pid + 1
    pcb.state = PROC_READY

    ; Give the process its own address space and make it the active root so the
    ; user stack (and any code the caller maps afterwards) lands inside it.
    root_pa: u64 = vmm.new_root()
    pcb.page_root = root_pa
    vmm.set_root(root_pa)

    ; User stack: a few pages below stack_top.
    stack_pages:  u64 = 4
    last_page_pa: u64 = 0
    for sp_i in 0..stack_pages {
        page_pa: u8* = pmm.alloc()
        if page_pa == null {
            runtime.panic("process_create: out of memory for user stack".ptr)
        }
        page_va: u64 = stack_top - (sp_i + 1) * 0x1000
        vmm.map(page_va, page_pa as u64, VMM_R + VMM_W + VMM_U)  ; vmm_map adds V.
        last_page_pa = page_pa as u64
    }
    pcb.user_stack_pa = last_page_pa
    pcb.entry_pc = entry_pc

    ; Initial frame: sp = stack top, sepc = entry, sstatus = U-mode with IRQs on.
    pcb.frame.x2 = stack_top
    pcb.frame.sepc = entry_pc
    pcb.frame.sstatus = 0x13

    return pcb
}

; Create a new user process with a stack at the canonical top. Isolation comes
; from the per-process page-table root, not from per-pid VA slots.
export process_create: (entry_pc: u64) -> layout.Pcb* {
    return process_create_at(entry_pc, USER_STACK_BASE)
}

; Allocate a zeroed PCB with the next pid but no address space or stack.
; Used by fork, which supplies the child's root and copies memory itself.
export process_alloc: () -> layout.Pcb* {
    pcb: layout.Pcb* = utilities.malloc(size_of<layout.Pcb>()) as layout.Pcb*
    mem.set(pcb as u8*, 0, size_of<layout.Pcb>())
    pcb.pid = next_pid
    next_pid = next_pid + 1
    pcb.state = PROC_READY
    return pcb
}

; --- PCB field accessors ---
; Keep PCB layout (OS spec ch.5.1) here; callers use these, not raw indices.

export process_pid: (pcb: layout.Pcb*) -> u64 {
    return pcb.pid
}

export process_state: (pcb: layout.Pcb*) -> u64 {
    return pcb.state
}

export process_set_state: (pcb: layout.Pcb*, s: u64) {
    pcb.state = s
}

export process_root: (pcb: layout.Pcb*) -> u64 {
    return pcb.page_root
}

export process_set_root: (pcb: layout.Pcb*, root: u64) {
    pcb.page_root = root
}

export process_parent: (pcb: layout.Pcb*) -> u64 {
    return pcb.parent_pid
}

export process_set_parent: (pcb: layout.Pcb*, ppid: u64) {
    pcb.parent_pid = ppid
}

export process_exit_code: (pcb: layout.Pcb*) -> i64 {
    return pcb.exit_code as i64
}

export process_set_exit_code: (pcb: layout.Pcb*, code: i64) {
    pcb.exit_code = code as u64
}

; Redirected stdout/stdin: the kernel fd backing this process's fd 1 / fd 0, or 0
; for the console (UART). See OS spec ch.7.7.
export process_stdout_fd: (pcb: layout.Pcb*) -> u64 {
    return pcb.stdout_fd
}

export process_set_stdout_fd: (pcb: layout.Pcb*, fd: u64) {
    pcb.stdout_fd = fd
}

export process_stdin_fd: (pcb: layout.Pcb*) -> u64 {
    return pcb.stdin_fd
}

export process_set_stdin_fd: (pcb: layout.Pcb*, fd: u64) {
    pcb.stdin_fd = fd
}

; Program break (top of the growable heap). 0 means "not yet initialised"; the
; sbrk handler resolves that to USER_HEAP_BASE on first use.
export process_heap_brk: (pcb: layout.Pcb*) -> u64 {
    return pcb.heap_brk
}

export process_set_heap_brk: (pcb: layout.Pcb*, brk: u64) {
    pcb.heap_brk = brk
}

; Address of the embedded 288-byte trap frame, for context copies.
export process_frame_addr: (pcb: layout.Pcb*) -> u64 {
    return (&pcb.frame) as u64
}
