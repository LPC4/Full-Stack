; Process construction and control-block access.

layout  := import("kernel/core/kernel_abi.hll")
config  := import("kernel/core/kernel_config.hll")
heap    := import("kernel/mm/kernel_heap.hll")
mem     := import("mem")
pages   := import("kernel/mm/physical_pages.hll")
address_space := import("kernel/mm/address_space.hll")
runtime := import("runtime")
klog    := import("klog")

; --- State ---

struct ProcessState {
    next_pid: u64,
}

const USER_STACK_BASE = 0x80000000

process_bookkeeping: ProcessState = {
    .next_pid = 1,
}

; --- Public API ---

export process_init: () {
    process_bookkeeping.next_pid = 1
    if size_of<layout.Pcb>() != PCB_SIZE or size_of<layout.TrapFrame>() != TF_BYTES {
        runtime.panic("kernel layout mismatch".ptr)
    }
    klog.ok("process subsystem ready".ptr)
}


export process_create: (entry_pc: u64) -> layout.Pcb* {
    return process_create_at(entry_pc, USER_STACK_BASE)
}

export process_alloc: () -> layout.Pcb* {
    pcb: layout.Pcb* = heap.alloc_bytes(size_of<layout.Pcb>()) as layout.Pcb*
    mem.set(pcb as u8*, 0, size_of<layout.Pcb>())
    pcb.pid = process_bookkeeping.next_pid
    process_bookkeeping.next_pid = process_bookkeeping.next_pid + 1
    pcb.state = PROC_READY
    return pcb
}

; --- Implementation ---

process_create_at: (entry_pc: u64, stack_top: u64) -> layout.Pcb* {
    pcb: layout.Pcb* = heap.alloc_bytes(size_of<layout.Pcb>()) as layout.Pcb*
    mem.set(pcb as u8*, 0, size_of<layout.Pcb>())

    pcb.pid = process_bookkeeping.next_pid
    process_bookkeeping.next_pid = process_bookkeeping.next_pid + 1
    pcb.state = PROC_READY

    root_pa: u64 = address_space.create()
    pcb.page_root = root_pa

    stack_pages:  u64 = 4
    last_page_pa: u64 = 0
    for sp_i in 0..stack_pages {
        page_pa: u8* = pages.alloc()
        if page_pa == null {
            runtime.panic("process_create: out of memory for user stack".ptr)
        }
        page_va: u64 = stack_top - (sp_i + 1) * 0x1000
        address_space.map(
            root_pa,
            page_va,
            page_pa as u64,
            config.PTE_READ + config.PTE_WRITE + config.PTE_USER,
        )
        last_page_pa = page_pa as u64
    }
    pcb.user_stack_pa = last_page_pa
    pcb.entry_pc = entry_pc

    pcb.frame.x2 = stack_top
    pcb.frame.sepc = entry_pc
    pcb.frame.sstatus = 0x13

    return pcb
}
