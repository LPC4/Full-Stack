; Round-robin scheduling and process queue ownership.

layout  := import("kernel/core/kernel_abi.hll")
mem     := import("mem")
address_space := import("kernel/mm/address_space.hll")
klog    := import("klog")

; --- State ---

struct SchedulerState {
    current: layout.Pcb*,
    ready: layout.Pcb*,
    zombies: layout.Pcb*,
    input_waiter: layout.Pcb*,
}

scheduler_state: SchedulerState = {
    .current = null,
    .ready = null,
    .zombies = null,
    .input_waiter = null,
}

; --- Public API ---

export scheduler_init: () {
    scheduler_state.current = null
    scheduler_state.ready = null
    scheduler_state.zombies = null
    scheduler_state.input_waiter = null
    klog.ok("scheduler ready".ptr)
}

export scheduler_current: () -> layout.Pcb* {
    return scheduler_state.current
}

export scheduler_add: (pcb: layout.Pcb*) {
    pcb.next = null
    if scheduler_state.ready == null {
        scheduler_state.ready = pcb
        return
    }
    curr: layout.Pcb* = scheduler_state.ready
    while curr.next != null {
        curr = curr.next
    }
    curr.next = pcb
}

export schedule: (frame: layout.TrapFrame*, action: layout.SysAction) {
    match action {
        Block -> {
            if scheduler_state.ready == null {
                scheduler_state.input_waiter = null
                return
            }
        }
        _ -> {}
    }

    if scheduler_state.current != null {
        mem.copy((&scheduler_state.current.frame) as u8*, frame as u8*, TF_BYTES)

        match action {
            ExitSchedule -> {
                scheduler_state.current.state = PROC_EXITED
            }
            Block -> {
                scheduler_state.current.state = PROC_BLOCKED
            }
            _ -> {
                scheduler_state.current.state = PROC_READY
                scheduler_add(scheduler_state.current)
            }
        }
    }

    next: layout.Pcb* = scheduler_state.ready
    if next == null {
        return
    }
    scheduler_state.ready = next.next
    next.next = null

    scheduler_state.current = next
    address_space.activate(next.page_root)
    mem.copy(frame as u8*, (&next.frame) as u8*, TF_BYTES)
}

export scheduler_set_input_waiter: (pcb: layout.Pcb*) {
    scheduler_state.input_waiter = pcb
}

export scheduler_wake_input_waiter: () -> u64 {
    w: layout.Pcb* = scheduler_state.input_waiter
    if w == null {
        return 0
    }
    scheduler_state.input_waiter = null
    w.state = PROC_READY
    w.next = scheduler_state.ready
    scheduler_state.ready = w
    return 1
}

export scheduler_ready_empty: () -> u64 {
    if scheduler_state.ready == null {
        return 1
    }
    return 0
}


export scheduler_pid_alive: (pid: u64) -> u64 {
    if scheduler_state.current != null {
        if scheduler_state.current.pid == pid {
            return 1
        }
    }
    if scheduler_state.input_waiter != null {
        if scheduler_state.input_waiter.pid == pid {
            return 1
        }
    }
    return scheduler_pid_in_queue(pid)
}

export scheduler_make_zombie: (pcb: layout.Pcb*) {
    pcb.next = scheduler_state.zombies
    scheduler_state.zombies = pcb
}

export scheduler_find_zombie_pid: (pid: u64) -> Option<layout.Pcb*> {
    curr: layout.Pcb* = scheduler_state.zombies
    while curr != null {
        if curr.pid == pid {
            return Some(curr)
        }
        curr = curr.next
    }
    return None
}

export scheduler_find_zombie_child: (parent_pid: u64) -> Option<layout.Pcb*> {
    curr: layout.Pcb* = scheduler_state.zombies
    while curr != null {
        if curr.parent_pid == parent_pid {
            return Some(curr)
        }
        curr = curr.next
    }
    return None
}

export scheduler_remove_zombie: (pcb: layout.Pcb*) {
    if (scheduler_state.zombies as u64) == (pcb as u64) {
        scheduler_state.zombies = pcb.next
        return
    }
    prev: layout.Pcb* = scheduler_state.zombies
    while prev != null {
        nxt: layout.Pcb* = prev.next
        if nxt == pcb {
            prev.next = pcb.next
            return
        }
        prev = nxt
    }
}

export scheduler_remove_ready: (target: u64, by_parent: bool) -> Option<layout.Pcb*> {
    previous: layout.Pcb* = null
    current: layout.Pcb* = scheduler_state.ready
    while current != null {
        matches: bool = current.pid == target
        if by_parent {
            matches = current.parent_pid == target
        }
        if matches {
            if previous == null {
                scheduler_state.ready = current.next
            } else {
                previous.next = current.next
            }
            return Some(current)
        }
        previous = current
        current = current.next
    }
    return None
}

export scheduler_has_children: (parent_pid: u64) -> u64 {
    curr: layout.Pcb* = scheduler_state.ready
    while curr != null {
        if curr.parent_pid == parent_pid {
            return 1
        }
        curr = curr.next
    }
    if scheduler_state.input_waiter != null {
        if scheduler_state.input_waiter.parent_pid == parent_pid {
            return 1
        }
    }
    z: layout.Pcb* = scheduler_state.zombies
    while z != null {
        if z.parent_pid == parent_pid {
            return 1
        }
        z = z.next
    }
    return 0
}

; --- Implementation ---

scheduler_pid_in_queue: (pid: u64) -> u64 {
    curr: layout.Pcb* = scheduler_state.ready
    while curr != null {
        if curr.pid == pid {
            return 1
        }
        curr = curr.next
    }
    return 0
}
