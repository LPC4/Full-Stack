; Static ELF64 segment loading into the requested address space.

files := import("kernel/fs/files.hll")
heap := import("kernel/mm/kernel_heap.hll")
config := import("kernel/core/kernel_config.hll")
mem := import("mem")
pages := import("kernel/mm/physical_pages.hll")
address_space := import("kernel/mm/address_space.hll")

; --- State ---

const PAGE_SIZE = 4096
const LOAD_FLAGS = config.PTE_READ + config.PTE_WRITE + config.PTE_EXECUTE + config.PTE_USER

; --- Public API ---

export enum ElfError {
    InvalidHeader
    TruncatedHeader
    OutOfMemory
    NoSegments
}

export elf_loader_header: (fd: i64, header: u8*) -> Result<u64, ElfError> {
    if files.read(fd, header, 0, 64) < 64 {
        return Err(ElfError.TruncatedHeader)
    }
    if @header != 0x7F || @(header + 1) != 69 ||
       @(header + 2) != 76 || @(header + 3) != 70 {
        return Err(ElfError.InvalidHeader)
    }
    return Ok(read_u64(header, 24))
}


export elf_loader_load: (root: u64, fd: i64, header: u8*) -> Result<u64, ElfError> {
    table_offset: u64 = read_u64(header, 32)
    entry_size: u64 = read_u16(header, 54)
    entry_count: u64 = read_u16(header, 56)
    program_header: u8* = heap.alloc_bytes(64)
    defer heap.free(program_header)

    loaded: i64 = 0
    for index in 0..entry_count {
        bytes: i64 = files.read(fd, program_header, table_offset + index * entry_size, 56)
        if bytes < 56 {
            return Err(ElfError.TruncatedHeader)
        }
        if read_u32(program_header, 0) == 1 {
            file_offset: u64 = read_u64(program_header, 8)
            virtual_address: u64 = read_u64(program_header, 16)
            file_size: u64 = read_u64(program_header, 32)
            memory_size: u64 = read_u64(program_header, 40)
            segment_offset: u64 = 0
            while segment_offset < memory_size {
                page: u8* = pages.alloc()
                if page == null {
                    return Err(ElfError.OutOfMemory)
                }
                mem.set(page, 0, PAGE_SIZE)
                if segment_offset < file_size {
                    count: u64 = file_size - segment_offset
                    if count > PAGE_SIZE {
                        count = PAGE_SIZE
                    }
                    files.read(fd, page, file_offset + segment_offset, count)
                }
                address_space.map(root, virtual_address + segment_offset, page as u64, LOAD_FLAGS)
                segment_offset = segment_offset + PAGE_SIZE
            }
            loaded = loaded + 1
        }
    }
    if loaded == 0 {
        return Err(ElfError.NoSegments)
    }
    return Ok(read_u64(header, 24))
}

; --- Utilities ---

read_u16: (bytes: u8*, offset: u64) -> u64 {
    next: u64 = offset + 1
    low: u8 = @(bytes + offset)
    high: u8 = @(bytes + next)
    return (low as u64) | ((high as u64) << 8)
}

read_u32: (bytes: u8*, offset: u64) -> u64 {
    return read_u16(bytes, offset) | (read_u16(bytes, offset + 2) << 16)
}

read_u64: (bytes: u8*, offset: u64) -> u64 {
    return read_u32(bytes, offset) | (read_u32(bytes, offset + 4) << 32)
}
